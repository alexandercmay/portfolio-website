---
/** Renders <a> when given href, <button> otherwise. Never the wrong element. */
interface Props {
  href?: string
  variant?: 'primary' | 'secondary'
  type?: 'button' | 'submit'
  download?: boolean | string
  class?: string
  /**
   * Puts a rocket on the pad in front of the label; it lifts on hover and on
   * keyboard focus.
   *
   * Only for the "reach out" action. A page where every button launches is a
   * page where launching means nothing, and the animation is decoration on an
   * action the label already names — so the glyph is aria-hidden and the
   * motion is behind prefers-reduced-motion.
   */
  launch?: boolean
}
const {
  href,
  variant = 'primary',
  type = 'button',
  download,
  class: className,
  launch,
} = Astro.props
const Tag = href ? 'a' : 'button'
---

<Tag
  class:list={['btn', variant, launch && 'launch', className]}
  href={href}
  download={download}
  type={href ? undefined : type}
>
  {
    launch && (
      <svg class="rocket" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          class="plume"
          d="M12 17.6c1.5 1.7 1.5 3.8 0 5.5-1.5-1.7-1.5-3.8 0-5.5Z"
          fill="currentColor"
        />
        <path
          d="M7.5 12.2 4.2 15.8v3.5l3.3-2.4Zm9 0 3.3 3.6v3.5l-3.3-2.4Z"
          fill="currentColor"
          opacity="0.75"
        />
        {/* Fuselage and porthole are one path with an even-odd fill, so the
            window is a hole and this needs no mask — and therefore no id.
            Two launch buttons render on the homepage, and a shared mask id
            would have made the second one draw the first one's window. */}
        <path
          d="M12 1.2c3.1 3.4 4.6 7.6 4.6 11.6v4.3H7.4v-4.3c0-4 1.5-8.2 4.6-11.6ZM14.1 8.4a2.1 2.1 0 1 0-4.2 0 2.1 2.1 0 1 0 4.2 0Z"
          fill="currentColor"
          fill-rule="evenodd"
        />
      </svg>
    )
  }
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.6em 1.1em;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--duration-state) var(--ease-out),
      border-color var(--duration-state) var(--ease-out),
      box-shadow var(--duration-state) var(--ease-out),
      color var(--duration-state) var(--ease-out);
  }

  .primary {
    background: var(--color-cyan);
    border-color: var(--color-cyan);
    /* Always the page ground, so this stays legible in both themes. */
    color: var(--color-bg);
  }

  .primary {
    box-shadow: var(--glow-cyan);
  }

  .primary:hover {
    box-shadow:
      var(--glow-cyan-lg),
      0 0 0 3px color-mix(in srgb, var(--color-cyan) 22%, transparent);
  }

  .secondary {
    background: var(--color-surface);
    border-color: var(--color-border);
    color: var(--color-text);
  }

  .secondary:hover {
    border-color: var(--color-cyan);
    color: var(--color-cyan);
    box-shadow: var(--glow-cyan);
  }

  /* ── Launch ────────────────────────────────────────────────────────── */
  .rocket {
    width: 1.05em;
    height: 1.05em;
    flex-shrink: 0;
    /* The label is what the reader is aiming at; the rocket is a cue beside
       it, not a second headline. */
    opacity: 0.85;
  }

  .plume {
    opacity: 0;
    transform-origin: 12px 17.6px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .rocket {
      transition:
        transform 220ms var(--ease-out),
        opacity var(--duration-state) var(--ease-out);
    }

    .plume {
      transition:
        opacity 220ms var(--ease-out),
        transform 220ms var(--ease-out);
    }

    /* Ignition. Small: this is a button, and a rocket that clears the label
       reads as a bug rather than as a launch. */
    .launch:hover .rocket,
    .launch:focus-visible .rocket {
      transform: translateY(-0.18em);
      opacity: 1;
    }

    .launch:hover .plume,
    .launch:focus-visible .plume {
      opacity: 0.7;
      transform: scaleY(1.25);
    }
  }
</style>

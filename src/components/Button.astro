---
/** Renders <a> when given href, <button> otherwise. Never the wrong element. */
interface Props {
  href?: string
  variant?: 'primary' | 'secondary'
  type?: 'button' | 'submit'
  download?: boolean | string
  class?: string
  /**
   * Puts a transmitting dish in front of the label; it starts sending on hover
   * and on keyboard focus.
   *
   * Only for the "reach out" action. A page where every button transmits is a
   * page where transmitting means nothing, and the animation is decoration on
   * an action the label already names — so the glyph is aria-hidden and the
   * motion is behind prefers-reduced-motion.
   *
   * This was a rocket first. A rocket says "launch", but the action is not
   * propulsion — it is sending a message to someone far away and hoping for an
   * answer, which is a transmission. The dish also matches the probe on the
   * 404, so the site speaks one language about reaching people instead of two.
   */
  transmit?: boolean
}
const {
  href,
  variant = 'primary',
  type = 'button',
  download,
  class: className,
  transmit,
} = Astro.props
const Tag = href ? 'a' : 'button'
---

<Tag
  class:list={['btn', variant, transmit && 'transmit', className]}
  href={href}
  download={download}
  type={href ? undefined : type}
>
  {
    transmit && (
      <svg class="dish" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M8.6 13.9 7.4 19.9h2.3l1.1-5.6Z" fill="currentColor" opacity="0.8" />
        <path d="M5.4 20.6h8.2v1.5H5.4Z" fill="currentColor" opacity="0.8" />
        <path
          d="M9.5 13.5 13 10.6"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
        />
        <circle cx="13.2" cy="10.4" r="1.15" fill="currentColor" />
        <ellipse
          cx="9.5"
          cy="13.5"
          rx="5.9"
          ry="3.2"
          transform="rotate(50 9.5 13.5)"
          fill="currentColor"
        />
        <g class="beam" fill="none" stroke="currentColor" stroke-linecap="round">
          <path
            class="arc"
            d="M10.59 7.30A6.3 6.3 0 0 1 15.21 10.84"
            stroke-width="1.3"
          />
          <path class="arc" d="M11.05 4.74A8.9 8.9 0 0 1 17.57 9.74" stroke-width="1.2" />
          <path
            class="arc"
            d="M11.50 2.18A11.5 11.5 0 0 1 19.92 8.64"
            stroke-width="1.1"
          />
        </g>
      </svg>
    )
  }
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.6em 1.1em;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--duration-state) var(--ease-out),
      border-color var(--duration-state) var(--ease-out),
      box-shadow var(--duration-state) var(--ease-out),
      color var(--duration-state) var(--ease-out);
  }

  .primary {
    background: var(--color-cyan);
    border-color: var(--color-cyan);
    /* Always the page ground, so this stays legible in both themes. */
    color: var(--color-bg);
  }

  .primary {
    box-shadow: var(--glow-cyan);
  }

  .primary:hover {
    box-shadow:
      var(--glow-cyan-lg),
      0 0 0 3px color-mix(in srgb, var(--color-cyan) 22%, transparent);
  }

  .secondary {
    background: var(--color-surface);
    border-color: var(--color-border);
    color: var(--color-text);
  }

  .secondary:hover {
    border-color: var(--color-cyan);
    color: var(--color-cyan);
    box-shadow: var(--glow-cyan);
  }

  /* ── Transmit ──────────────────────────────────────────────────────── */
  .dish {
    width: 1.15em;
    height: 1.15em;
    flex-shrink: 0;
    /* The label is what the reader is aiming at; the dish is a cue beside it,
       not a second headline. */
    opacity: 0.85;
  }

  /* At rest the dish is pointed but quiet. The arcs are what say "sending",
     so they are the part that waits for the pointer. */
  .arc {
    opacity: 0;
    transform-origin: 9.5px 13.5px;
  }

  .transmit:hover .dish,
  .transmit:focus-visible .dish {
    opacity: 1;
  }

  /* Held still, hovering simply lights the arcs up — the button still reads
     as transmitting without any motion at all. */
  .transmit:hover .arc,
  .transmit:focus-visible .arc {
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dish {
      transition: opacity var(--duration-state) var(--ease-out);
    }

    .transmit:hover .arc,
    .transmit:focus-visible .arc {
      opacity: 0;
      animation: transmit 1.5s var(--ease-out) infinite;
    }

    .transmit:hover .arc:nth-child(2),
    .transmit:focus-visible .arc:nth-child(2) {
      animation-delay: 0.18s;
    }

    .transmit:hover .arc:nth-child(3),
    .transmit:focus-visible .arc:nth-child(3) {
      animation-delay: 0.36s;
    }
  }

  @keyframes transmit {
    0% {
      opacity: 0;
      transform: scale(0.7);
    }
    30% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: scale(1.15);
    }
  }
</style>

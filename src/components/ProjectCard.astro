---
import { Image } from 'astro:assets'
import Badge from './Badge.astro'
import StackChips from './StackChips.astro'
import { formatMonth } from '@/lib/content'
import type { Project } from '@/lib/content'

interface Props {
  project: Project
}
const { project } = Astro.props
const d = project.data
---

{
  /*
  Only the heading is a link, with an overlay stretching the hit area across
  the card. Wrapping the whole card in an <a> would build the link's accessible
  name from every scrap of text inside it. This way the link is named
  "Chalk Talk" and the card is still fully clickable. The chips sit above the
  overlay so they stay independently clickable.
*/
}
<article class="card panel marks">
  {
    d.cover && (
      <div class="cover">
        <Image src={d.cover} alt="" width={640} height={360} />
      </div>
    )
  }

  <div class="meta">
    <Badge status={d.status} />
    <span class="updated">{formatMonth(d.updated)}</span>
  </div>

  <h3>
    <a href={`/projects/${project.id}`}>{d.title}</a>
  </h3>
  <p class="tagline">{d.tagline}</p>

  <div class="chips">
    <StackChips stack={d.stack} />
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.35rem;
    transition:
      border-color var(--duration-state) var(--ease-out),
      background-color var(--duration-state) var(--ease-out);
  }

  .card:hover {
    border-color: var(--color-cyan);
    background: var(--color-raised);
    box-shadow: var(--glow-cyan);
  }

  /* No cover image is the normal case, not a broken one — the layout must not
     depend on it. */
  .cover :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .meta {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .updated {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  h3 {
    font-size: var(--text-xl);
    margin: 0;
  }

  h3 a {
    text-decoration: none;
    color: inherit;
  }

  /* Stretch the heading link across the card. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .card:hover h3 a {
    color: var(--color-cyan);
  }

  .tagline {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* Above the overlay, so chips stay clickable in their own right. */
  .chips {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: 0.35rem;
  }
</style>

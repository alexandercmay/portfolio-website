---
interface Props {
  title: string
  href?: string
  linkLabel?: string
  /**
   * Position of this section in the page's system, "01"-"05".
   *
   * It selects which celestial body is drawn beside the title — 01 is the
   * star everything else orbits, and the rest run outward from it. It still
   * orders the sections; it just is not rendered as a numeral any more.
   */
  index?: string
  /** Set so the enclosing <section> can point aria-labelledby at it. */
  id?: string
}
const { title, href, linkLabel, index, id } = Astro.props

/**
 * The section markers, as one small planetary system.
 *
 * They replace the "01"-"05" numerals. A number beside a heading is a table of
 * contents; this page is a sky, and a body in that sky says the same thing —
 * "third one out" — without a second typographic voice competing with the
 * title.
 *
 * The last one is not a body. Four worlds out from the star, and then the
 * thing that leaves: Get in touch is where a reader stops looking and starts
 * moving, so it gets a rocket on the pad rather than another rock.
 *
 * Every body is one SOLID disc with pieces cut out of it, never a shape drawn
 * in the background colour. At 18px a solid silhouette with a cutout stays
 * legible where an outline-and-fill drawing turns to mush, and a cutout is
 * genuinely transparent, so these survive sitting on the page's starfield.
 *
 * The mask ids carry the index because five of these render on one page and
 * duplicate ids would make every section draw the first section's cutouts.
 */
const BODIES = ['star', 'ringed', 'banded', 'crescent', 'rocket'] as const
const body = BODIES[(Number(index) || 1) - 1] ?? 'star'
const uid = `body-${index ?? '1'}`
---

<div class="header charge">
  <h2 id={id}>
    {
      index && (
        <svg
          class="body"
          data-body={body}
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          {body === 'star' && (
            <>
              {/* Corona, then the four diffraction spikes, then the core. */}
              <circle cx="12" cy="12" r="9.5" fill="currentColor" opacity="0.14" />
              <path
                d="M12 1.5v5M12 17.5v5M1.5 12h5M17.5 12h5"
                stroke="currentColor"
                stroke-width="1.1"
                stroke-linecap="round"
                opacity="0.55"
              />
              <circle cx="12" cy="12" r="5.6" fill="currentColor" />
            </>
          )}

          {body === 'ringed' && (
            <>
              <ellipse
                cx="12"
                cy="12"
                rx="11"
                ry="3.6"
                transform="rotate(-22 12 12)"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
                opacity="0.7"
              />
              <circle cx="12" cy="12" r="6" fill="currentColor" />
            </>
          )}

          {body === 'banded' && (
            <>
              <mask id={`${uid}-mask`}>
                <circle cx="12" cy="12" r="7" fill="#fff" />
                <rect x="0" y="8.4" width="24" height="1.6" fill="#000" />
                <rect x="0" y="13.2" width="24" height="2.2" fill="#000" />
              </mask>
              <circle
                cx="12"
                cy="12"
                r="7"
                fill="currentColor"
                mask={`url(#${uid}-mask)`}
              />
            </>
          )}

          {body === 'crescent' && (
            <>
              {/* The unlit limb is cut away, not painted over, so the starfield
                  shows through it. */}
              <mask id={`${uid}-mask`}>
                <circle cx="12" cy="12" r="7" fill="#fff" />
                <circle cx="15.6" cy="10.4" r="6.4" fill="#000" />
              </mask>
              <circle
                cx="12"
                cy="12"
                r="7"
                fill="currentColor"
                mask={`url(#${uid}-mask)`}
              />
            </>
          )}

          {body === 'rocket' && (
            <>
              {/* Exhaust first, so the fuselage sits on top of it. */}
              <path
                class="plume"
                d="M12 17.6c1.5 1.7 1.5 3.8 0 5.5-1.5-1.7-1.5-3.8 0-5.5Z"
                fill="currentColor"
                opacity="0.5"
              />
              <path
                d="M7.5 12.2 4.2 15.8v3.5l3.3-2.4Zm9 0 3.3 3.6v3.5l-3.3-2.4Z"
                fill="currentColor"
                opacity="0.75"
              />
              {/* Fuselage and porthole in one path with an even-odd fill:
                  the window is a hole, so this body needs no mask at all. */}
              <path
                d="M12 1.2c3.1 3.4 4.6 7.6 4.6 11.6v4.3H7.4v-4.3c0-4 1.5-8.2 4.6-11.6ZM14.1 8.4a2.1 2.1 0 1 0-4.2 0 2.1 2.1 0 1 0 4.2 0Z"
                fill="currentColor"
                fill-rule="evenodd"
              />
            </>
          )}
        </svg>
      )
    }
    {title}
  </h2>
  {
    href && (
      <a class="more" href={href}>
        {linkLabel ?? 'See all'} &rarr;
      </a>
    )
  }
</div>

<style>
  .header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  h2 {
    display: flex;
    /* Centred, not baseline-aligned: a disc has no baseline to sit on, and
       baseline alignment hung it below the title's optical centre. */
    align-items: center;
    gap: 0.65rem;
    font-size: var(--text-2xl);
    margin: 0;
  }

  /* The section marker — aria-hidden, so a screen reader hears the section
     name rather than a decoration in front of it. */
  .body {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-cyan);
    overflow: visible;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--color-cyan) 40%, transparent));
  }

  /* The star is the brightest thing in the system, and the rocket is lit by
     its own engine. Everything between them is merely lit, not luminous. */
  .body[data-body='star'],
  .body[data-body='rocket'] {
    filter: drop-shadow(0 0 9px color-mix(in srgb, var(--color-cyan) 60%, transparent));
  }

  /* The pad is live: the plume breathes rather than sitting still. Motion is
     opt-in — a heading marker is not worth overriding a stated preference. */
  @media (prefers-reduced-motion: no-preference) {
    .body[data-body='rocket'] .plume {
      animation: plume 1.6s var(--ease-out) infinite;
      transform-origin: 12px 17.6px;
    }
  }

  @keyframes plume {
    0%,
    100% {
      opacity: 0.32;
      transform: scaleY(0.72);
    }
    50% {
      opacity: 0.62;
      transform: scaleY(1.08);
    }
  }

  .more {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-state) var(--ease-out);
  }

  .more:hover {
    color: var(--color-cyan);
  }
</style>

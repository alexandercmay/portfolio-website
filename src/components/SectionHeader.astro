---
interface Props {
  title: string
  href?: string
  linkLabel?: string
  /**
   * Position of this section in the page, "01"-"05".
   *
   * It selects which marker is drawn beside the title. It still orders the
   * sections; it just is not rendered as a numeral any more.
   */
  index?: string
  /** Set so the enclosing <section> can point aria-labelledby at it. */
  id?: string
}
const { title, href, linkLabel, index, id } = Astro.props

/**
 * The section markers.
 *
 * They replace the "01"-"05" numerals. A number beside a heading is a table of
 * contents; this page is a sky, and something in that sky can say what the
 * section IS without a second typographic voice competing with the title.
 *
 * Each marker encodes MEANING, not position. The first version of this was a
 * planetary system ordered outward — first section, innermost world — and it
 * failed for a reason worth recording: position is not meaning. Skills got a
 * gas giant because it was third, not because it was Skills, and once the
 * dish arrived (which is not a body at all) the remaining planets read as
 * arbitrary rather than as a system.
 *
 *   01 Experience    a star, burning and working
 *   02 Projects      a ringed world with a moon — and, at a glance, an eye
 *   03 Skills        the Big Dipper — a constellation you can actually name
 *   04 Education     a sextant — how you learn to place yourself
 *   05 Get in touch  a dish, mid-transmission
 *
 * The dish is not a rocket, which was the first version of that one. A rocket
 * says "launch", but the action here is not propulsion — it is sending a
 * message to someone far away and hoping for an answer. That is a
 * transmission, and it gives the site ONE comms language: the same arcs the
 * lost probe on the 404 is sending.
 *
 * Filled silhouettes and weighted strokes, and where a shape ever needs a hole
 * it is a real cutout via an even-odd fill, never a shape painted in the
 * background colour — these sit on the starfield, so a "hole" in the ground
 * colour would be an opaque blot over the stars. At 24px a heavy silhouette
 * stays legible where an outline-and-fill drawing turns to mush, which is why
 * each of these has ONE dominant mass and the rest is detail hung off it.
 *
 * No ids anywhere in here, deliberately. Five of these render on one page, and
 * an earlier pass used masks whose ids had to be hand-namespaced or every
 * section would draw the first section's cutouts. Even-odd fills need no ids,
 * so the whole class of bug is gone.
 */
const BODIES = ['star', 'ringed', 'constellation', 'sextant', 'dish'] as const
const body = BODIES[(Number(index) || 1) - 1] ?? 'star'
---

<div class="header charge">
  <h2 id={id}>
    {
      index && (
        <svg
          class="body"
          data-body={body}
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          {body === 'star' && (
            <>
              {/* Corona, then the four diffraction spikes, then the core. */}
              <circle cx="12" cy="12" r="9.5" fill="currentColor" opacity="0.14" />
              <path
                d="M12 1.5v5M12 17.5v5M1.5 12h5M17.5 12h5"
                stroke="currentColor"
                stroke-width="1.1"
                stroke-linecap="round"
                opacity="0.55"
              />
              <circle cx="12" cy="12" r="5.6" fill="currentColor" />
            </>
          )}

          {body === 'ringed' && (
            <>
              {/* A ringed world with a moon sitting on the rim — which also
                  reads as an EYE, and that is the point rather than an
                  accident. 02 is the section you look into.

                  The ring is 2.3px and steeply tilted, and both numbers are
                  load-bearing. An earlier version of this idea drew the second
                  body on a 0.9px orbit and it simply vanished: at the 1.5rem
                  these actually render at, a stroke under about 1.5px is not a
                  line, it is a rumour, and what survived was two unrelated
                  dots. Anything decorative in this set has to be MASS or a
                  genuinely bold stroke — there is no middle setting.

                  The steep rotation is what turns a ring into an iris. The old
                  ring lay almost flat (-22 degrees, ry 3.6), which reads as
                  Saturn seen edge-on; opening it to ry 5.8 at -30 degrees
                  closes the ellipse toward a circle and the eye appears. */}
              <ellipse
                cx="12"
                cy="12"
                rx="9.8"
                ry="5.8"
                transform="rotate(-30 12 12)"
                fill="none"
                stroke="currentColor"
                stroke-width="2.3"
                opacity="0.48"
              />
              <circle cx="12" cy="12" r="4.8" fill="currentColor" />
              {/* Parked on the ansa — the tip of the ring's major axis, where
                  a real ring is widest and where the moon looks seated rather
                  than floating near the line. Move the ellipse and this has to
                  move with it or it detaches. */}
              <circle cx="20.5" cy="7.1" r="2.9" fill="currentColor" />
            </>
          )}

          {body === 'constellation' && (
            <>
              {/* The Big Dipper.

                  This was an abstract four-star asterism, then briefly
                  Cassiopeia, and the test both failed is the only one that
                  matters here: a constellation marker works if the viewer
                  NAMES it. An invented asterism is a squiggle, and the W is
                  only obvious to people who already know it. The Dipper is
                  the one nearly everyone can pick out, so it is the one that
                  does the section's job without a caption.

                  The Little Dipper was the other candidate and lost on the
                  same criterion — its bowl stars are genuinely faint, and it
                  is mostly recognised by finding the Dipper first. Worth
                  knowing it had an argument though: Polaris would have rhymed
                  with the sextant at 04, which measures against a star.

                  BOWL is a quadrilateral, HANDLE is three stars off its
                  upper-right corner. The handle attaches at Megrez, which is
                  drawn smallest on purpose — every radius here tracks real
                  apparent magnitude, and Megrez at 3.3 is famously the faint
                  one in an otherwise 1.8-2.4 asterism. Alioth and Dubhe are
                  the brightest and are drawn largest.

                  The bowl is NOT filled, though a fill would help it hold
                  together at 24px. A constellation is points of light plus a
                  line somebody imagined between them; fill the bowl and it
                  stops being an asterism and becomes a bucket. So the stars
                  carry the mass and the lines stay at 1.5px and 48% — which
                  is above the ~1.5px floor the rest of this file keeps
                  running into, and no thinner.

                  This is the busiest marker in the set: seven stars and six
                  segments where the others have at most five shapes. It holds
                  at the 1.5rem these render at, but it is at the limit — do
                  not add anything to it. */}
              <path
                d="M9.8 9.8 2.2 7.8 3.4 17.6 10.6 18.2Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
                opacity="0.48"
              />
              <path
                d="M9.8 9.8 14.6 8.8 19 6.6 22.2 2.6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                opacity="0.48"
              />
              {/* Bowl: Dubhe, Merak, Phecda, Megrez. */}
              <circle cx="2.2" cy="7.8" r="2.5" fill="currentColor" />
              <circle cx="3.4" cy="17.6" r="2" fill="currentColor" />
              <circle cx="10.6" cy="18.2" r="1.9" fill="currentColor" />
              <circle cx="9.8" cy="9.8" r="1.35" fill="currentColor" />
              {/* Handle: Alioth, Mizar, Alkaid. */}
              <circle cx="14.6" cy="8.8" r="2.5" fill="currentColor" />
              <circle cx="19" cy="6.6" r="2" fill="currentColor" />
              <circle cx="22.2" cy="2.6" r="2.4" fill="currentColor" />
            </>
          )}

          {body === 'sextant' && (
            <>
              {/* A sextant sighting a star.

                  This replaces an observatory dome that never worked. The dome
                  went through three rewrites — a hill on a plinth, then a
                  frankly phallic shaft on a drum, then a wide low version that
                  read as a bell — and the problem was never the drawing. A
                  building is a bad 24px object: its meaning lives in the dome,
                  which is a featureless curve at that size.

                  The sextant is also a better claim. A dome is where you go;
                  a sextant is what you DO — measure the angle between a star
                  and the horizon to work out where you are. That is closer to
                  what an education is for, and it speaks the instrument-panel
                  language the rest of the site is built in.

                  The LIMB is the heavy mass; frame, index arm and pivot hang
                  off it. Three details keep it from reading as an anchor,
                  which is the failure mode of any wide arc under a vertical
                  stem: the frame is lighter than the limb, the index arm is
                  heavier and runs OFF-AXIS, and it breaks past the limb rather
                  than stopping at it. Symmetry is what made it an anchor. */}
              <path
                d="M4.2 15.2A9.8 9.8 0 0 0 19.8 15.2"
                fill="none"
                stroke="currentColor"
                stroke-width="3.4"
                stroke-linecap="round"
              />
              <path
                d="M12 5 6 17M12 5 18 17"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                opacity="0.6"
              />
              {/* The index arm — the part that actually takes the measurement,
                  so it is the one line drawn at full weight. */}
              <path
                d="M12 5 15.6 19"
                stroke="currentColor"
                stroke-width="2.3"
                stroke-linecap="round"
              />
              <circle cx="12" cy="4.8" r="2.2" fill="currentColor" />
              {/* The star being shot. Same move the dish makes with its arcs:
                  an instrument aimed at something reads as working, not
                  parked — and it ties 04 back to the sky the other four
                  markers live in. */}
              <circle cx="20.8" cy="4" r="1.6" fill="currentColor" opacity="0.9" />
            </>
          )}

          {body === 'dish' && (
            <>
              {/* Dish, feed horn on its arm, and the mast it sits on. The
                  rim ellipse's long axis runs down-right, so the dish faces
                  up-left of it — out of the frame, at the sky. */}
              <path
                d="M8.6 13.9 7.4 19.9h2.3l1.1-5.6Z"
                fill="currentColor"
                opacity="0.8"
              />
              <path d="M5.4 20.6h8.2v1.5H5.4Z" fill="currentColor" opacity="0.8" />
              <path
                d="M9.5 13.5 13 10.6"
                stroke="currentColor"
                stroke-width="1"
                stroke-linecap="round"
              />
              <circle cx="13.2" cy="10.4" r="1.15" fill="currentColor" />
              <ellipse
                cx="9.5"
                cy="13.5"
                rx="5.9"
                ry="3.2"
                transform="rotate(50 9.5 13.5)"
                fill="currentColor"
              />
              {/* The transmission. Three arcs on the dish's axis. */}
              <g class="beam" fill="none" stroke="currentColor" stroke-linecap="round">
                <path
                  class="arc"
                  d="M10.59 7.30A6.3 6.3 0 0 1 15.21 10.84"
                  stroke-width="1.3"
                />
                <path
                  class="arc"
                  d="M11.05 4.74A8.9 8.9 0 0 1 17.57 9.74"
                  stroke-width="1.2"
                />
                <path
                  class="arc"
                  d="M11.50 2.18A11.5 11.5 0 0 1 19.92 8.64"
                  stroke-width="1.1"
                />
              </g>
            </>
          )}
        </svg>
      )
    }
    {title}
  </h2>
  {
    href && (
      <a class="more" href={href}>
        {linkLabel ?? 'See all'} &rarr;
      </a>
    )
  }
</div>

<style>
  .header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  h2 {
    display: flex;
    /* Centred, not baseline-aligned: a disc has no baseline to sit on, and
       baseline alignment hung it below the title's optical centre. */
    align-items: center;
    gap: 0.65rem;
    font-size: var(--text-2xl);
    margin: 0;
  }

  /* The section marker — aria-hidden, so a screen reader hears the section
     name rather than a decoration in front of it. */
  .body {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-cyan);
    overflow: visible;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--color-cyan) 40%, transparent));
  }

  /* The star is the brightest thing in the system, and the dish is lit by what
     it is transmitting. Everything between them is merely lit, not luminous. */
  .body[data-body='star'],
  .body[data-body='dish'] {
    filter: drop-shadow(0 0 9px color-mix(in srgb, var(--color-cyan) 60%, transparent));
  }

  .arc {
    opacity: 0.28;
    transform-origin: 9.5px 13.5px;
  }

  /* The dish is live: arcs leave it rather than sitting on it, each one a
     beat behind the last. Motion is opt-in — a heading marker is not worth
     overriding a stated preference, and the arcs read fine held still. */
  @media (prefers-reduced-motion: no-preference) {
    .arc {
      animation: transmit 2.8s var(--ease-out) infinite;
    }

    .arc:nth-child(2) {
      animation-delay: 0.3s;
    }

    .arc:nth-child(3) {
      animation-delay: 0.6s;
    }
  }

  @keyframes transmit {
    0% {
      opacity: 0;
      transform: scale(0.72);
    }
    35% {
      opacity: 0.75;
    }
    100% {
      opacity: 0;
      transform: scale(1.12);
    }
  }

  .more {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-state) var(--ease-out);
  }

  .more:hover {
    color: var(--color-cyan);
  }
</style>

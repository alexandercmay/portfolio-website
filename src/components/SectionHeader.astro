---
interface Props {
  title: string
  href?: string
  linkLabel?: string
  /** Set so the enclosing <section> can point aria-labelledby at it. An
      unnamed <section> is landmark noise for screen reader users. */
  id?: string
}
const { title, href, linkLabel, id } = Astro.props
---

<div class="header">
  <h2 id={id}>{title}</h2>
  {href && <a href={href}>{linkLabel ?? 'See all'} &rarr;</a>}
</div>

<style>
  .header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  h2 {
    font-size: var(--text-2xl);
    margin: 0;
  }

  a {
    flex-shrink: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-accent);
  }
</style>

---
interface Props {
  title: string
  href?: string
  linkLabel?: string
  /**
   * Position of this section in the page's system, "01"-"05".
   *
   * It selects which celestial body is drawn beside the title — 01 is the
   * star everything else orbits, and the rest run outward from it. It still
   * orders the sections; it just is not rendered as a numeral any more.
   */
  index?: string
  /** Set so the enclosing <section> can point aria-labelledby at it. */
  id?: string
}
const { title, href, linkLabel, index, id } = Astro.props

/**
 * The section markers, as one small planetary system.
 *
 * They replace the "01"-"05" numerals. A number beside a heading is a table of
 * contents; this page is a sky, and a body in that sky says the same thing —
 * "third one out" — without a second typographic voice competing with the
 * title.
 *
 * The last one is not a body. Four worlds out from the star, and then the
 * thing that listens: Get in touch is where a reader stops looking and starts
 * moving, so it gets a dish rather than another rock.
 *
 * A dish and not a rocket, which was the first version of this. A rocket says
 * "launch", but the action here is not propulsion — it is sending a message to
 * someone far away and hoping for an answer. That is a transmission. It also
 * gives the site ONE comms language: the same arcs the lost probe on the 404
 * is sending.
 *
 * Every body is one SOLID disc with pieces cut out of it, never a shape drawn
 * in the background colour. At 18px a solid silhouette with a cutout stays
 * legible where an outline-and-fill drawing turns to mush, and a cutout is
 * genuinely transparent, so these survive sitting on the page's starfield.
 *
 * The mask ids carry the index because five of these render on one page and
 * duplicate ids would make every section draw the first section's cutouts.
 */
const BODIES = ['star', 'ringed', 'banded', 'crescent', 'dish'] as const
const body = BODIES[(Number(index) || 1) - 1] ?? 'star'
const uid = `body-${index ?? '1'}`
---

<div class="header charge">
  <h2 id={id}>
    {
      index && (
        <svg
          class="body"
          data-body={body}
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          {body === 'star' && (
            <>
              {/* Corona, then the four diffraction spikes, then the core. */}
              <circle cx="12" cy="12" r="9.5" fill="currentColor" opacity="0.14" />
              <path
                d="M12 1.5v5M12 17.5v5M1.5 12h5M17.5 12h5"
                stroke="currentColor"
                stroke-width="1.1"
                stroke-linecap="round"
                opacity="0.55"
              />
              <circle cx="12" cy="12" r="5.6" fill="currentColor" />
            </>
          )}

          {body === 'ringed' && (
            <>
              <ellipse
                cx="12"
                cy="12"
                rx="11"
                ry="3.6"
                transform="rotate(-22 12 12)"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
                opacity="0.7"
              />
              <circle cx="12" cy="12" r="6" fill="currentColor" />
            </>
          )}

          {body === 'banded' && (
            <>
              <mask id={`${uid}-mask`}>
                <circle cx="12" cy="12" r="7" fill="#fff" />
                <rect x="0" y="8.4" width="24" height="1.6" fill="#000" />
                <rect x="0" y="13.2" width="24" height="2.2" fill="#000" />
              </mask>
              <circle
                cx="12"
                cy="12"
                r="7"
                fill="currentColor"
                mask={`url(#${uid}-mask)`}
              />
            </>
          )}

          {body === 'crescent' && (
            <>
              {/* The unlit limb is cut away, not painted over, so the starfield
                  shows through it. */}
              <mask id={`${uid}-mask`}>
                <circle cx="12" cy="12" r="7" fill="#fff" />
                <circle cx="15.6" cy="10.4" r="6.4" fill="#000" />
              </mask>
              <circle
                cx="12"
                cy="12"
                r="7"
                fill="currentColor"
                mask={`url(#${uid}-mask)`}
              />
            </>
          )}

          {body === 'dish' && (
            <>
              {/* Dish, feed horn on its arm, and the mast it sits on. The
                  rim ellipse's long axis runs down-right, so the dish faces
                  up-left of it — out of the frame, at the sky. */}
              <path
                d="M8.6 13.9 7.4 19.9h2.3l1.1-5.6Z"
                fill="currentColor"
                opacity="0.8"
              />
              <path d="M5.4 20.6h8.2v1.5H5.4Z" fill="currentColor" opacity="0.8" />
              <path
                d="M9.5 13.5 13 10.6"
                stroke="currentColor"
                stroke-width="1"
                stroke-linecap="round"
              />
              <circle cx="13.2" cy="10.4" r="1.15" fill="currentColor" />
              <ellipse
                cx="9.5"
                cy="13.5"
                rx="5.9"
                ry="3.2"
                transform="rotate(50 9.5 13.5)"
                fill="currentColor"
              />
              {/* The transmission. Three arcs on the dish's axis. */}
              <g class="beam" fill="none" stroke="currentColor" stroke-linecap="round">
                <path
                  class="arc"
                  d="M10.59 7.30A6.3 6.3 0 0 1 15.21 10.84"
                  stroke-width="1.3"
                />
                <path
                  class="arc"
                  d="M11.05 4.74A8.9 8.9 0 0 1 17.57 9.74"
                  stroke-width="1.2"
                />
                <path
                  class="arc"
                  d="M11.50 2.18A11.5 11.5 0 0 1 19.92 8.64"
                  stroke-width="1.1"
                />
              </g>
            </>
          )}
        </svg>
      )
    }
    {title}
  </h2>
  {
    href && (
      <a class="more" href={href}>
        {linkLabel ?? 'See all'} &rarr;
      </a>
    )
  }
</div>

<style>
  .header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  h2 {
    display: flex;
    /* Centred, not baseline-aligned: a disc has no baseline to sit on, and
       baseline alignment hung it below the title's optical centre. */
    align-items: center;
    gap: 0.65rem;
    font-size: var(--text-2xl);
    margin: 0;
  }

  /* The section marker — aria-hidden, so a screen reader hears the section
     name rather than a decoration in front of it. */
  .body {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-cyan);
    overflow: visible;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--color-cyan) 40%, transparent));
  }

  /* The star is the brightest thing in the system, and the dish is lit by what
     it is transmitting. Everything between them is merely lit, not luminous. */
  .body[data-body='star'],
  .body[data-body='dish'] {
    filter: drop-shadow(0 0 9px color-mix(in srgb, var(--color-cyan) 60%, transparent));
  }

  .arc {
    opacity: 0.28;
    transform-origin: 9.5px 13.5px;
  }

  /* The dish is live: arcs leave it rather than sitting on it, each one a
     beat behind the last. Motion is opt-in — a heading marker is not worth
     overriding a stated preference, and the arcs read fine held still. */
  @media (prefers-reduced-motion: no-preference) {
    .arc {
      animation: transmit 2.8s var(--ease-out) infinite;
    }

    .arc:nth-child(2) {
      animation-delay: 0.3s;
    }

    .arc:nth-child(3) {
      animation-delay: 0.6s;
    }
  }

  @keyframes transmit {
    0% {
      opacity: 0;
      transform: scale(0.72);
    }
    35% {
      opacity: 0.75;
    }
    100% {
      opacity: 0;
      transform: scale(1.12);
    }
  }

  .more {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-state) var(--ease-out);
  }

  .more:hover {
    color: var(--color-cyan);
  }
</style>

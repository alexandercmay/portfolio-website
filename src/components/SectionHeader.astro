---
interface Props {
  title: string
  href?: string
  linkLabel?: string
  /**
   * Position of this section in the page, "01"-"05".
   *
   * It selects which marker is drawn beside the title. It still orders the
   * sections; it just is not rendered as a numeral any more.
   */
  index?: string
  /** Set so the enclosing <section> can point aria-labelledby at it. */
  id?: string
}
const { title, href, linkLabel, index, id } = Astro.props

/**
 * The section markers.
 *
 * They replace the "01"-"05" numerals. A number beside a heading is a table of
 * contents; this page is a sky, and something in that sky can say what the
 * section IS without a second typographic voice competing with the title.
 *
 * Each marker encodes MEANING, not position. The first version of this was a
 * planetary system ordered outward — first section, innermost world — and it
 * failed for a reason worth recording: position is not meaning. Skills got a
 * gas giant because it was third, not because it was Skills, and once the
 * dish arrived (which is not a body at all) the remaining planets read as
 * arbitrary rather than as a system.
 *
 *   01 Experience    a star, burning and working
 *   02 Projects      a ringed planet — distinct worlds, built
 *   03 Skills        a constellation — literally what the section contains
 *   04 Education     an observatory dome — where you learn to look
 *   05 Get in touch  a dish, mid-transmission
 *
 * The dish is not a rocket, which was the first version of that one. A rocket
 * says "launch", but the action here is not propulsion — it is sending a
 * message to someone far away and hoping for an answer. That is a
 * transmission, and it gives the site ONE comms language: the same arcs the
 * lost probe on the 404 is sending.
 *
 * Filled silhouettes, and where a shape needs a hole — the observatory's slit,
 * the dish's dark side — it is a real cutout via an even-odd fill, never a
 * shape painted in the background colour. At 24px a solid silhouette with a
 * cutout stays legible where an outline-and-fill drawing turns to mush, and a
 * cutout is genuinely transparent, so these survive sitting on the starfield.
 *
 * No ids anywhere in here, deliberately. Five of these render on one page, and
 * an earlier pass used masks whose ids had to be hand-namespaced or every
 * section would draw the first section's cutouts. Even-odd fills need no ids,
 * so the whole class of bug is gone.
 */
const BODIES = ['star', 'ringed', 'constellation', 'observatory', 'dish'] as const
const body = BODIES[(Number(index) || 1) - 1] ?? 'star'
---

<div class="header charge">
  <h2 id={id}>
    {
      index && (
        <svg
          class="body"
          data-body={body}
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          {body === 'star' && (
            <>
              {/* Corona, then the four diffraction spikes, then the core. */}
              <circle cx="12" cy="12" r="9.5" fill="currentColor" opacity="0.14" />
              <path
                d="M12 1.5v5M12 17.5v5M1.5 12h5M17.5 12h5"
                stroke="currentColor"
                stroke-width="1.1"
                stroke-linecap="round"
                opacity="0.55"
              />
              <circle cx="12" cy="12" r="5.6" fill="currentColor" />
            </>
          )}

          {body === 'ringed' && (
            <>
              <ellipse
                cx="12"
                cy="12"
                rx="11"
                ry="3.6"
                transform="rotate(-22 12 12)"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
                opacity="0.7"
              />
              <circle cx="12" cy="12" r="6" fill="currentColor" />
            </>
          )}

          {body === 'constellation' && (
            <>
              {/* An asterism: four stars and the chain joining them. The
                  second is the bright one, the way a real constellation has
                  an anchor star you find first. */}
              <path
                d="M4.8 16.6 9.6 8.2 15 13.6 19.6 6.6"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                stroke-linecap="round"
                stroke-linejoin="round"
                opacity="0.55"
              />
              <circle cx="4.8" cy="16.6" r="1.5" fill="currentColor" />
              <circle cx="9.6" cy="8.2" r="2.3" fill="currentColor" />
              <circle cx="15" cy="13.6" r="1.6" fill="currentColor" />
              <circle cx="19.6" cy="6.6" r="1.8" fill="currentColor" />
            </>
          )}

          {body === 'observatory' && (
            <>
              {/* Dome and its open slit in one even-odd path, so the sky shows
                  through the opening rather than the page ground being painted
                  over it. */}
              <path
                d="M4.5 18.6a7.5 7.5 0 0 1 15 0Z
                   M12 12.1a1.1 1.1 0 0 1 1.1 1.1v5.4h-2.2v-5.4A1.1 1.1 0 0 1 12 12.1Z"
                fill="currentColor"
                fill-rule="evenodd"
              />
              <path d="M3.2 19.6h17.6v2.4H3.2Z" fill="currentColor" opacity="0.85" />
            </>
          )}

          {body === 'dish' && (
            <>
              {/* Dish, feed horn on its arm, and the mast it sits on. The
                  rim ellipse's long axis runs down-right, so the dish faces
                  up-left of it — out of the frame, at the sky. */}
              <path
                d="M8.6 13.9 7.4 19.9h2.3l1.1-5.6Z"
                fill="currentColor"
                opacity="0.8"
              />
              <path d="M5.4 20.6h8.2v1.5H5.4Z" fill="currentColor" opacity="0.8" />
              <path
                d="M9.5 13.5 13 10.6"
                stroke="currentColor"
                stroke-width="1"
                stroke-linecap="round"
              />
              <circle cx="13.2" cy="10.4" r="1.15" fill="currentColor" />
              <ellipse
                cx="9.5"
                cy="13.5"
                rx="5.9"
                ry="3.2"
                transform="rotate(50 9.5 13.5)"
                fill="currentColor"
              />
              {/* The transmission. Three arcs on the dish's axis. */}
              <g class="beam" fill="none" stroke="currentColor" stroke-linecap="round">
                <path
                  class="arc"
                  d="M10.59 7.30A6.3 6.3 0 0 1 15.21 10.84"
                  stroke-width="1.3"
                />
                <path
                  class="arc"
                  d="M11.05 4.74A8.9 8.9 0 0 1 17.57 9.74"
                  stroke-width="1.2"
                />
                <path
                  class="arc"
                  d="M11.50 2.18A11.5 11.5 0 0 1 19.92 8.64"
                  stroke-width="1.1"
                />
              </g>
            </>
          )}
        </svg>
      )
    }
    {title}
  </h2>
  {
    href && (
      <a class="more" href={href}>
        {linkLabel ?? 'See all'} &rarr;
      </a>
    )
  }
</div>

<style>
  .header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  h2 {
    display: flex;
    /* Centred, not baseline-aligned: a disc has no baseline to sit on, and
       baseline alignment hung it below the title's optical centre. */
    align-items: center;
    gap: 0.65rem;
    font-size: var(--text-2xl);
    margin: 0;
  }

  /* The section marker — aria-hidden, so a screen reader hears the section
     name rather than a decoration in front of it. */
  .body {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-cyan);
    overflow: visible;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--color-cyan) 40%, transparent));
  }

  /* The star is the brightest thing in the system, and the dish is lit by what
     it is transmitting. Everything between them is merely lit, not luminous. */
  .body[data-body='star'],
  .body[data-body='dish'] {
    filter: drop-shadow(0 0 9px color-mix(in srgb, var(--color-cyan) 60%, transparent));
  }

  .arc {
    opacity: 0.28;
    transform-origin: 9.5px 13.5px;
  }

  /* The dish is live: arcs leave it rather than sitting on it, each one a
     beat behind the last. Motion is opt-in — a heading marker is not worth
     overriding a stated preference, and the arcs read fine held still. */
  @media (prefers-reduced-motion: no-preference) {
    .arc {
      animation: transmit 2.8s var(--ease-out) infinite;
    }

    .arc:nth-child(2) {
      animation-delay: 0.3s;
    }

    .arc:nth-child(3) {
      animation-delay: 0.6s;
    }
  }

  @keyframes transmit {
    0% {
      opacity: 0;
      transform: scale(0.72);
    }
    35% {
      opacity: 0.75;
    }
    100% {
      opacity: 0;
      transform: scale(1.12);
    }
  }

  .more {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-state) var(--ease-out);
  }

  .more:hover {
    color: var(--color-cyan);
  }
</style>

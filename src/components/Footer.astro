---
interface Props {
  /** Build time, so the "last updated" claim is honest. */
  updated?: Date
}
const { updated = new Date() } = Astro.props
const stamp = updated.toISOString().slice(0, 10)

const links = [
  { href: 'mailto:alexcmay11@gmail.com', label: 'email' },
  { href: 'https://github.com/alexandercmay', label: 'github' },
  { href: 'https://www.linkedin.com/in/alexandercmay/', label: 'linkedin' },
]
---

<footer>
  <div class="inner">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
    <p class="stamp">
      <span class="dim" aria-hidden="true">build</span>
      {stamp}
    </p>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--spacing-section);
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    max-width: var(--container-content);
    margin: 0 auto;
    padding: 1.75rem 1.5rem 2.5rem;
  }

  ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-state) var(--ease-out);
  }

  a:hover {
    color: var(--color-cyan);
  }

  .stamp {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .dim {
    opacity: 0.6;
    margin-right: 0.4em;
  }
</style>

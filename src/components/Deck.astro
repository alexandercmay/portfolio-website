---
/**
 * A role's headline accomplishment, set at --text-deck.
 *
 * The size is unforgiving on purpose: a vague sentence looks worse set large
 * than it does buried in a bullet list. If a deck reads weakly here, the
 * sentence is wrong — not the type size. See docs/02-content-model.md.
 */
interface Props {
  as?: 'p' | 'h2' | 'h3'
  class?: string
}
const { as: Tag = 'p', class: className } = Astro.props
---

<Tag class:list={['deck', className]}><slot /></Tag>

<style>
  .deck {
    font-family: var(--font-mono);
    font-size: var(--text-deck);
    font-weight: 500;
    line-height: var(--leading-deck);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    max-width: 40ch;
    margin: 0;
    color: var(--color-text);
  }
</style>

---
import type { Capability } from '../../content/resume'

/**
 * The schematic drawn at the end of a capability row.
 *
 * These are SCHEMATICS, not icons: each one draws the shape of the system it
 * names, so it carries information a padlock or a brain glyph cannot. They are
 * decorative in the accessibility sense — the capability's name, claim and
 * proof lines carry all the meaning — so the <svg> is aria-hidden and the
 * caller owns colour via `currentColor`.
 *
 * One geometry across all three, or they read as three clip-art picks rather
 * than a set: a 128x72 box, 1.4 stroke, nothing outside the box, and a filled
 * mass for the thing doing the work with hollow outlines for everything that
 * routes, holds or defends.
 *
 * The language is HARDWARE — dies, pads, vias, guard rings. Four other
 * families were drawn and rejected before this one, and two of the failures
 * are worth recording so they are not tried again:
 *
 *   celestial (orbits, accretion disks, a Dyson sphere) — beautiful, and it
 *     collides head-on with SkillGalaxy. Two different star systems on one
 *     page meaning two different things is worse than either alone.
 *   patch bay (jacks, cables, indicator LEDs) — the most legible of the lot
 *     and semantically backwards: a patch bay is a human plugging cables in by
 *     hand, which is the opposite of what all three rows claim.
 */
interface Props {
  name: Capability['glyph']
  class?: string
}
const { name, class: className } = Astro.props
---

<svg
  class:list={['glyph', className]}
  viewBox="0 0 128 72"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    /* AI — a die with its pins broken out to pads. */
    name === 'ai' && (
      <>
        <rect
          x="46"
          y="20"
          width="36"
          height="32"
          rx="4"
          fill="currentColor"
          opacity="0.12"
        />
        <rect x="46" y="20" width="36" height="32" rx="4" />
        <rect
          x="57"
          y="30"
          width="14"
          height="12"
          rx="2"
          fill="currentColor"
          stroke="none"
        />
        <path
          d="M46 28H38M46 36H38M46 44H38M82 28h8M82 36h8M82 44h8M54 20v-7M64 20v-7M74 20v-7M54 52v7M64 52v7M74 52v7"
          opacity="0.55"
        />
        <path d="M38 28 26 16H14" opacity="0.45" />
        <path d="M38 44 26 56H14" opacity="0.45" />
        <path d="M90 28 102 16h12" opacity="0.45" />
        <path d="M90 44 102 56h12" opacity="0.45" />
        <circle cx="26" cy="16" r="2.4" opacity="0.6" />
        <circle cx="26" cy="56" r="2.4" opacity="0.6" />
        <circle cx="102" cy="16" r="2.4" opacity="0.6" />
        <circle cx="102" cy="56" r="2.4" opacity="0.6" />
        <rect
          x="2"
          y="12"
          width="12"
          height="8"
          rx="2"
          fill="currentColor"
          opacity="0.5"
          stroke="none"
        />
        <rect
          x="2"
          y="52"
          width="12"
          height="8"
          rx="2"
          fill="currentColor"
          opacity="0.5"
          stroke="none"
        />
        <rect
          x="114"
          y="12"
          width="12"
          height="8"
          rx="2"
          fill="currentColor"
          opacity="0.5"
          stroke="none"
        />
        <rect
          x="114"
          y="52"
          width="12"
          height="8"
          rx="2"
          fill="currentColor"
          opacity="0.5"
          stroke="none"
        />
      </>
    )
  }

  {
    /* BACKEND — four stages on a shared clock, one message in flight through
       stage two. The clock line is what makes it a pipeline rather than four
       boxes with arrows between them. */
    name === 'backend' && (
      <>
        <path d="M2 34h8" opacity="0.6" />
        <path d="M6 30l5 4-5 4" opacity="0.6" />
        <rect x="10" y="24" width="22" height="20" rx="3" />
        <rect
          x="38"
          y="24"
          width="22"
          height="20"
          rx="3"
          fill="currentColor"
          opacity="0.16"
        />
        <rect x="38" y="24" width="22" height="20" rx="3" />
        <rect
          x="45"
          y="30"
          width="8"
          height="8"
          rx="1.5"
          fill="currentColor"
          stroke="none"
        />
        <rect x="66" y="24" width="22" height="20" rx="3" />
        <rect x="94" y="24" width="22" height="20" rx="3" />
        <path d="M32 34h6M60 34h6M88 34h6M116 34h10" opacity="0.7" />
        <path d="M120 30l5 4-5 4" opacity="0.7" />
        <path d="M6 58h116" opacity="0.35" />
        <path
          d="M21 44v14M49 44v14M77 44v14M105 44v14"
          stroke-dasharray="3 3"
          opacity="0.3"
        />
        <circle cx="21" cy="58" r="2" fill="currentColor" stroke="none" opacity="0.5" />
        <circle cx="49" cy="58" r="2" fill="currentColor" stroke="none" opacity="0.5" />
        <circle cx="77" cy="58" r="2" fill="currentColor" stroke="none" opacity="0.5" />
        <circle cx="105" cy="58" r="2" fill="currentColor" stroke="none" opacity="0.5" />
      </>
    )
  }

  {
    /* SECURITY — a guard ring with stitching vias. Two traces are terminated
       dead at the ring; the one vetted call crosses, through a gated via.
       That termination is the whole claim: not a wall, a checked crossing. */
    name === 'security' && (
      <>
        <rect x="46" y="6" width="76" height="60" rx="7" opacity="0.75" />
        <rect x="51" y="11" width="66" height="50" rx="5" opacity="0.35" />
        <circle
          cx="60"
          cy="8.5"
          r="1.7"
          fill="currentColor"
          stroke="none"
          opacity="0.7"
        />
        <circle
          cx="84"
          cy="8.5"
          r="1.7"
          fill="currentColor"
          stroke="none"
          opacity="0.7"
        />
        <circle
          cx="108"
          cy="8.5"
          r="1.7"
          fill="currentColor"
          stroke="none"
          opacity="0.7"
        />
        <circle
          cx="60"
          cy="63.5"
          r="1.7"
          fill="currentColor"
          stroke="none"
          opacity="0.7"
        />
        <circle
          cx="84"
          cy="63.5"
          r="1.7"
          fill="currentColor"
          stroke="none"
          opacity="0.7"
        />
        <circle
          cx="108"
          cy="63.5"
          r="1.7"
          fill="currentColor"
          stroke="none"
          opacity="0.7"
        />
        <circle
          cx="119.5"
          cy="26"
          r="1.7"
          fill="currentColor"
          stroke="none"
          opacity="0.7"
        />
        <circle
          cx="119.5"
          cy="46"
          r="1.7"
          fill="currentColor"
          stroke="none"
          opacity="0.7"
        />
        <rect
          x="70"
          y="26"
          width="30"
          height="22"
          rx="3"
          fill="currentColor"
          opacity="0.16"
        />
        <rect x="70" y="26" width="30" height="22" rx="3" />
        <rect
          x="80"
          y="33"
          width="10"
          height="8"
          rx="1.5"
          fill="currentColor"
          stroke="none"
        />
        <path d="M2 16h38" opacity="0.6" />
        <path d="M40 11v10" stroke-width="2" opacity="0.85" />
        <path d="M2 56h38" opacity="0.6" />
        <path d="M40 51v10" stroke-width="2" opacity="0.85" />
        <path d="M2 36h40" opacity="0.8" />
        <circle cx="46" cy="36" r="4.2" fill="currentColor" opacity="0.2" />
        <circle cx="46" cy="36" r="4.2" />
        <path d="M50 36h20" opacity="0.8" />
      </>
    )
  }
</svg>

<style>
  .glyph {
    display: block;
    width: 100%;
    height: auto;
    color: var(--color-cyan);
  }
</style>

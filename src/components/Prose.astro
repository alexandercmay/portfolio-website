---
/**
 * Long-form container. Measure capped at 68ch — full-width prose is one of the
 * most common flaws in developer portfolios.
 */
interface Props {
  class?: string
}
const { class: className } = Astro.props
---

<div class:list={['prose', className]}><slot /></div>

<style>
  .prose {
    max-width: var(--container-prose);
  }

  /* Mono headings, sans body. A 600-word writeup set entirely in mono is a
     wall — readability wins over aesthetic consistency here. */
  .prose :global(h2) {
    font-size: var(--text-2xl);
    margin: 2.75rem 0 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border);
  }

  .prose :global(h3) {
    font-size: var(--text-xl);
    margin: 2rem 0 0.5rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  /* Prose is the ONE place that does not wear `.marker-list`, and it is a
     deliberate exception rather than an oversight.

     That class works by setting `list-style: none` and drawing a star in
     `::before`, and `list-style: none` drops list semantics in Safari/VoiceOver
     — which is why every list wearing it also carries `role="list"`. These
     lists are generated from MDX, so there is nowhere to put that attribute
     short of a rehype plugin, and astro.config.mjs already weighed that and
     declined: Astro 7 runs the Sätteri processor, and rehype means installing
     @astrojs/markdown-remark to opt back into the slower unified one.

     Trading a screen reader's "list, 5 items" for a prettier bullet is a bad
     trade, so the native marker stays and only its colour is aligned. Cyan on
     the default disc reads as the same family as the star without touching
     semantics. */
  .prose :global(li)::marker {
    color: var(--color-cyan);
  }

  .prose :global(a) {
    color: var(--color-cyan);
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-raised);
    border: 1px solid var(--color-border);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    color: var(--color-cyan);
  }

  .prose :global(pre) {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow-x: auto;
    margin: 0 0 1.5rem;
  }

  .prose :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
  }

  .prose :global(blockquote) {
    margin: 0 0 1.4rem;
    padding-left: 1.1rem;
    border-left: 2px solid var(--color-cyan);
    color: var(--color-text-muted);
  }

  .prose :global(strong) {
    color: var(--color-text);
  }
</style>

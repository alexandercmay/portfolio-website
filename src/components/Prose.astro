---
/**
 * Long-form container. Measure capped at 68ch — full-width prose is one of the
 * most common flaws in developer portfolios.
 */
interface Props {
  class?: string
}
const { class: className } = Astro.props
---

<div class:list={['prose', className]}><slot /></div>

<style>
  .prose {
    max-width: var(--container-prose);
  }

  .prose :global(h2) {
    font-size: var(--text-2xl);
    margin: 2.5rem 0 0.75rem;
  }

  .prose :global(h3) {
    font-size: var(--text-xl);
    margin: 2rem 0 0.5rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(a) {
    color: var(--color-accent);
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-surface-sunk);
    padding: 0.12em 0.35em;
    border-radius: var(--radius-sm);
  }

  .prose :global(pre) {
    padding: 1rem 1.1rem;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 0 0 1.4rem;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(blockquote) {
    margin: 0 0 1.4rem;
    padding-left: 1.1rem;
    border-left: 2px solid var(--color-border);
    color: var(--color-text-muted);
  }
</style>

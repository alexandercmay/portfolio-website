---
import { TECH, type TechKey } from '../../content/taxonomy'
import { getStackUsage } from '@/lib/content'

interface Props {
  groups: { category: string; items: readonly TechKey[] }[]
}
const { groups } = Astro.props

/**
 * Only link technologies that actually have a /stack/:tech page.
 *
 * Stack pages are generated from real usage in projects and work history, so a
 * skill listed on the resume but not yet used in either has no page. Linking
 * it anyway produces a 404 — which is worse than not linking, and exactly the
 * kind of dead link a reviewer clicks first.
 */
const linkable = new Set((await getStackUsage()).map((u) => u.key))
---

{
  /* Inner groups are <div>, not <section> — they are groupings, not
    landmarks, and an unnamed <section> is noise in the landmark list. */
}
<div class="skills">
  {
    groups.map((group) => (
      <div>
        <h3>{group.category}</h3>
        <p class="items">
          {group.items.map((key, i) => (
            <>
              {i > 0 && <span class="sep"> · </span>}
              {linkable.has(key) ? (
                <a href={`/stack/${key}`}>{TECH[key].label}</a>
              ) : (
                <span>{TECH[key].label}</span>
              )}
            </>
          ))}
        </p>
      </div>
    ))
  }
</div>

<style>
  /* A typographic composition, not a row of uniform pills. No proficiency
     bars — nobody believes them, and "React 90%" invites a question you
     cannot answer. */
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2rem 2.5rem;
  }

  h3 {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin: 0 0 0.6rem;
  }

  .items {
    margin: 0;
    line-height: 1.9;
  }

  a {
    color: var(--color-text);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .sep {
    color: var(--color-text-subtle);
  }
</style>

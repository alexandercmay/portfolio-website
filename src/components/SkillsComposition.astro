---
import { TECH, type TechKey } from '../../content/taxonomy'

interface Props {
  groups: { category: string; items: readonly TechKey[] }[]
}
const { groups } = Astro.props
---

{
  /* Inner groups are <div>, not <section> — they are groupings, not landmarks,
    and an unnamed <section> is noise in the landmark list. */
}
<div class="skills">
  {
    groups.map((group) => (
      <div class="group">
        <h3>{group.category}</h3>
        <ul>
          {group.items.map((key) => (
            <li>{TECH[key].label}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  /* A readout, not a row of uniform pills. No proficiency bars — nobody
     believes them, and "React 90%" invites a question you cannot answer. */
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.75rem 2.5rem;
  }

  .group {
    border-left: 1px solid var(--color-border);
    padding-left: 1rem;
  }

  h3 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-cyan);
    margin: 0 0 0.7rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.9;
    color: var(--color-text-muted);
  }
</style>

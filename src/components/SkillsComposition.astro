---
import { TECH, type TechKey } from '../../content/taxonomy'

interface Props {
  groups: { category: string; items: readonly TechKey[] }[]
}
const { groups } = Astro.props
---

{
  /* Inner groups are <div>, not <section> — they are groupings, not
    landmarks, and an unnamed <section> is noise in the landmark list. */
}
<div class="skills">
  {
    groups.map((group) => (
      <div>
        <h3>{group.category}</h3>
        <p class="items">
          {group.items.map((key, i) => (
            <>
              {i > 0 && <span class="sep"> · </span>}
              <span>{TECH[key].label}</span>
            </>
          ))}
        </p>
      </div>
    ))
  }
</div>

<style>
  /* A typographic composition, not a row of uniform pills. No proficiency
     bars — nobody believes them, and "React 90%" invites a question you
     cannot answer. */
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2rem 2.5rem;
  }

  h3 {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin: 0 0 0.6rem;
  }

  .items {
    margin: 0;
    line-height: 1.9;
    color: var(--color-text);
  }

  .sep {
    color: var(--color-text-subtle);
  }
</style>

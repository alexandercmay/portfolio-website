---
interface Props {
  as?: string
}
const { as: Tag = 'span' } = Astro.props
---

<Tag class="vh"><slot /></Tag>

<style>
  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>

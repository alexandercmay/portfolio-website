---
/**
 * Neutral by design. Stack chips are NOT colour-coded — the accents are
 * semantic data channels, and spending them on twenty technology tags would
 * make them mean nothing. See docs/04-design-system.md.
 */
interface Props {
  href?: string
  class?: string
}
const { href, class: className } = Astro.props
const Tag = href ? 'a' : 'span'
---

<Tag class:list={['chip', className]} href={href}><slot /></Tag>

<style>
  .chip {
    display: inline-block;
    padding: 0.25em 0.6em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.5;
    text-decoration: none;
    white-space: nowrap;
  }

  a.chip {
    transition:
      color var(--duration-state) var(--ease-out),
      border-color var(--duration-state) var(--ease-out);
  }

  a.chip:hover {
    color: var(--color-cyan);
    border-color: var(--color-cyan);
  }
</style>

---
import { TECH, type TechKey } from '../../content/taxonomy'

interface Props {
  groups: { category: string; items: readonly TechKey[] }[]
}
const { groups } = Astro.props

/**
 * Skills as star clusters — one constellation per category.
 *
 * Positions are computed HERE, at build time, and baked into inline styles.
 * Nothing is calculated in the browser, so this ships zero JavaScript like
 * everything else.
 *
 * Reads as a star chart rather than as a diagram of boxes:
 *  - the CATEGORY is the constellation name — letterspaced small caps with a
 *    catalog designation under it, no border and no background. A bordered
 *    chip is a UI control; a constellation name is a caption on the sky.
 *  - each STAR is labelled with the technology, and the label sits on the side
 *    facing AWAY from the cluster centre, so text radiates outward and the
 *    lines in the middle stay clean
 *  - stars vary in magnitude, and the brightest of each constellation carries
 *    diffraction spikes
 *
 * Accessibility contract:
 *  - Every skill NAME is always visible. Hover only adds glow and emphasis;
 *    it never reveals information. Hover-gated content would exclude keyboard
 *    and touch users outright.
 *  - DOM order stays logical (category, then items in declared order) even
 *    though the visual placement is scattered — a screen reader reads the
 *    grouped list, not the scatter.
 *  - Below 60rem the whole thing falls back to a plain grouped list, because
 *    a scattered galaxy on a phone is unreadable.
 *  - The constellation lines are decorative and aria-hidden.
 *
 * Known cost: a scatter is harder to scan than a column. /resume keeps the
 * clean grouped list so a scannable version of this information always exists.
 */

/** Deterministic hash → stable positions across builds. */
function hash(s: string): number {
  let h = 2166136261
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i)
    h = Math.imul(h, 16777619)
  }
  return (h >>> 0) / 4294967295
}

/*
 * Layout is solved in PIXELS at build time, then converted to percentages.
 *
 * Three rewrites, and the first two failed in ways that measurement missed:
 *
 *  1. Jittered rings, no relaxation      -> 11 overlapping labels
 *  2. Global relaxation + cohesion pull  -> clusters INTERLEAVED, and labels
 *     drifted away from their own stars entirely
 *
 * The second failure is the instructive one. "Minimum distance between stars
 * of different clusters" stayed healthy while constellations were threaded
 * through each other, because that metric cannot see interleaving at all. A
 * label sat over a foreign cluster's stars and the numbers looked fine.
 *
 * So the layout is now TERRITORIAL rather than emergent:
 *
 *   - cluster centres are placed far apart by hand, which is what actually
 *     prevents interleaving (measured: removing the radius clamp below changes
 *     nothing; moving the centres together produces 13 intruders immediately)
 *   - a radius clamp caps how far a star may sit from its own centre. At the
 *     current centre spacing it never binds — it is a bound on cluster GROWTH,
 *     so one large category cannot sprawl into a neighbour if the skill list
 *     expands
 *   - labels are placed AFTER the stars settle, from each cluster's actual
 *     bounding box, so a label can never drift away from its own stars
 *   - only then are labels relaxed against the stars, with the stars pinned
 */
const W = 1100
const H = 820
const CHAR = 7.2 // --text-xs in JetBrains Mono, px per character
const LABEL_CHAR = 9.9 // constellation name: 11px + 0.3em tracking
const BOX_H = 22
const PAD = 18 // dot + gap
const MARGIN = 16

/**
 * How far a star may sit from its own cluster centre.
 *
 * A bound on cluster growth, not the thing preventing interleaving — measured,
 * disabling it changes the layout not at all at the current centre spacing.
 * It matters only if a category grows large enough to sprawl.
 */
const MAX_R = 152

type Node = {
  key: string
  label: string
  cluster: number
  x: number
  y: number
  w: number
  h: number
  /**
   * Where the collision box sits relative to (x, y).
   *
   * (x, y) is the STAR itself — the point lines terminate at — but the box
   * that must not overlap anything also contains the name, which hangs off one
   * side. Keeping the two separate is what stopped the lines from stopping
   * short in the middle of a word.
   */
  ox: number
  /** -1 label to the left of the star, +1 to the right. */
  side: number
  r: number
}

/**
 * Cluster territories, in a 3-over-2 arrangement. Centres are >340px apart
 * horizontally and >370px vertically, comfortably more than 2 * MAX_R, so the
 * territories cannot touch.
 */
const CENTRES = [
  // These positions are load-bearing: they, not the radius clamp, are what
  // keeps constellations from threading through each other.
  { x: W * 0.17, y: H * 0.23 },
  { x: W * 0.5, y: H * 0.21 },
  { x: W * 0.84, y: H * 0.26 },
  { x: W * 0.24, y: H * 0.73 },
  { x: W * 0.63, y: H * 0.74 },
]

/** Centre of a node's collision box (the star plus its outward-hanging name). */
const bx = (n: Node) => n.x + n.ox

const stars: Node[] = []

groups.forEach((group, gi) => {
  const c = CENTRES[gi % CENTRES.length]
  const n = group.items.length
  // Fill the territory rather than hugging the centre — the previous pass
  // read as a tight knot.
  const spread = n === 1 ? 0 : Math.min(0.52 * MAX_R + n * 9, MAX_R * 0.82)

  group.items.forEach((key, i) => {
    const seed = hash(key)
    const angle = (i / Math.max(n, 1)) * Math.PI * 2 + seed * 0.7
    const rad = spread * (0.68 + seed * 0.32)
    const label = TECH[key as TechKey].label
    // Names point away from the cluster centre, so the constellation lines run
    // through open space instead of through text.
    const side = Math.cos(angle) >= 0 ? 1 : -1
    const w = label.length * CHAR + PAD
    stars.push({
      key,
      label,
      cluster: gi,
      x: c.x + Math.cos(angle) * rad,
      y: c.y + Math.sin(angle) * rad * 0.74,
      w,
      h: BOX_H,
      ox: (side * w) / 2,
      side,
      // Magnitude. Skewed small so a few stars read as bright rather than all
      // of them reading as medium — an even spread looks like a scatter plot.
      r: 1.6 + Math.pow(seed, 1.5) * 2.9,
    })
  })
})

/** Push overlapping boxes apart along the axis of least penetration. */
function separate(movable: Node[], fixed: Node[], passes: number, clamp = true) {
  for (let iter = 0; iter < passes; iter++) {
    for (let i = 0; i < movable.length; i++) {
      for (let j = 0; j < movable.length + fixed.length; j++) {
        const a = movable[i]
        const b = j < movable.length ? movable[j] : fixed[j - movable.length]
        if (a === b) continue
        const dx = bx(b) - bx(a)
        const dy = b.y - a.y
        const ox = (a.w + b.w) / 2 + MARGIN - Math.abs(dx)
        const oy = (a.h + b.h) / 2 + MARGIN - Math.abs(dy)
        if (ox <= 0 || oy <= 0) continue
        const bMovable = j < movable.length
        if (ox < oy) {
          const push = (ox / (bMovable ? 2 : 1)) * (dx < 0 ? -1 : 1)
          a.x -= push
          if (bMovable) b.x += push
        } else {
          const push = (oy / (bMovable ? 2 : 1)) * (dy < 0 ? -1 : 1)
          a.y -= push
          if (bMovable) b.y += push
        }
      }
    }

    for (const nd of movable) {
      if (clamp) {
        // Caps cluster radius. Dormant at current centre spacing.
        const c = CENTRES[nd.cluster % CENTRES.length]
        const dx = nd.x - c.x
        const dy = nd.y - c.y
        const d = Math.hypot(dx, dy)
        if (d > MAX_R) {
          nd.x = c.x + (dx / d) * MAX_R
          nd.y = c.y + (dy / d) * MAX_R
        }
      }
      // Clamp the BOX to the canvas, then solve back for the star.
      nd.x = Math.max(nd.w / 2 + 4 - nd.ox, Math.min(W - nd.w / 2 - 4 - nd.ox, nd.x))
      nd.y = Math.max(nd.h / 2 + 4, Math.min(H - nd.h / 2 - 4, nd.y))
    }
  }
}

separate(stars, [], 120)

/*
 * Labels last, derived from where the stars actually ended up. Placing them
 * beforehand is what let a label drift away from its own constellation.
 */
const labels: Node[] = groups.map((group, gi) => {
  const mine = stars.filter((s) => s.cluster === gi)
  const minX = Math.min(...mine.map((s) => bx(s) - s.w / 2))
  const maxX = Math.max(...mine.map((s) => bx(s) + s.w / 2))
  const minY = Math.min(...mine.map((s) => s.y - s.h / 2))
  return {
    key: `label-${gi}`,
    label: group.category,
    cluster: gi,
    x: (minX + maxX) / 2,
    y: minY - 40,
    w: Math.max(group.category.length * LABEL_CHAR, 92) + 20,
    h: 40,
    ox: 0,
    side: 1,
    r: 0,
  }
})

// Stars are pinned; only labels move.
separate(labels, stars, 60, false)

/**
 * Constellation lines = the Euclidean minimum spanning tree of the cluster.
 *
 * The previous version drew spokes from a hub, which is how you draw a bicycle
 * wheel, not a constellation: every star pointed at the same middle and the
 * result read as an asterisk. An MST connects each star to its nearest
 * already-connected neighbour, which is exactly the chain-of-nearest-stars
 * shape real star charts use — and it stays inside its own territory for free,
 * since the nearest neighbour of a star is always one of its own.
 */
function spanningTree(nodes: Node[]): [Node, Node][] {
  const edges: [Node, Node][] = []
  if (nodes.length < 2) return edges

  const inTree = [nodes[0]]
  const rest = nodes.slice(1)
  while (rest.length > 0) {
    let best = Infinity
    let from = inTree[0]
    let at = 0
    for (const a of inTree) {
      for (let k = 0; k < rest.length; k++) {
        const d = Math.hypot(a.x - rest[k].x, a.y - rest[k].y)
        if (d < best) {
          best = d
          from = a
          at = k
        }
      }
    }
    const [to] = rest.splice(at, 1)
    edges.push([from, to])
    inTree.push(to)
  }
  return edges
}

const clusters = groups.map((group, gi) => {
  const mine = stars.filter((s) => s.cluster === gi)
  const label = labels[gi]
  // Exactly one star per constellation carries diffraction spikes. More than
  // one and the flare stops meaning "this is the bright one".
  const brightest = mine.reduce((a, b) => (b.r > a.r ? b : a))
  return {
    category: group.category,
    // A catalog designation, the way a real star cluster is labelled.
    designation: `NGC ${(gi + 1) * 1147}`,
    count: mine.length,
    label: { x: (label.x / W) * 100, y: (label.y / H) * 100 },
    lines: spanningTree(mine).map(([a, b]) => ({
      x1: a.x,
      y1: a.y,
      x2: b.x,
      y2: b.y,
    })),
    stars: mine.map((s) => ({
      key: s.key,
      label: s.label,
      x: (s.x / W) * 100,
      y: (s.y / H) * 100,
      r: s.r,
      side: s.side,
      bright: s === brightest,
    })),
  }
})
---

<div class="galaxy-wrap">
  {
    /* Desktop: the scatter. Each cluster is its own container spanning the
      canvas, so hovering a category name can light that constellation and
      nothing else. Containers are pointer-transparent; their children are
      not, so the overlapping full-size boxes never steal a hover. */
  }
  <div
    class="galaxy"
    aria-hidden="true"
    data-canvas={`${W}x${H}`}
    data-star-box={`${CHAR},${PAD},${BOX_H}`}
  >
    <svg class="lines" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
      {
        clusters.map((c, i) => (
          <g class="cluster-lines" style={`--spec: var(--c-spec-${(i % 5) + 1})`}>
            {c.lines.map((l) => (
              <line
                x1={l.x1}
                y1={l.y1}
                x2={l.x2}
                y2={l.y2}
                vector-effect="non-scaling-stroke"
              />
            ))}
          </g>
        ))
      }
    </svg>

    {
      clusters.map((c, i) => (
        <div class="cluster" style={`--spec: var(--c-spec-${(i % 5) + 1})`}>
          <p class="cluster-label" style={`left:${c.label.x}%;top:${c.label.y}%`}>
            <span class="cname">{c.category}</span>
            <span class="desig">
              {c.designation} · {c.count}
            </span>
          </p>

          {c.stars.map((s) => (
            <span
              class="star"
              data-side={s.side > 0 ? 'right' : 'left'}
              data-bright={s.bright ? '' : undefined}
              style={`left:${s.x}%;top:${s.y}%;--r:${s.r.toFixed(2)}px`}
            >
              <span class="dot" />
              <span class="name">{s.label}</span>
            </span>
          ))}
        </div>
      ))
    }
  </div>

  {
    /* The real, readable content. Visible on narrow screens; on wide screens
      it is the screen-reader path while the scatter above is aria-hidden. */
  }
  <div class="galaxy-list">
    {
      groups.map((group, i) => (
        <div class="list-group" style={`--spec: var(--c-spec-${(i % 5) + 1})`}>
          <h3>{group.category}</h3>
          <ul>
            {group.items.map((key) => (
              <li>{TECH[key].label}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</div>

<style>
  /* ── Scatter ───────────────────────────────────────────────────────── */
  .galaxy {
    display: none;
  }

  @media (min-width: 60rem) {
    .galaxy {
      display: block;
      position: relative;
      aspect-ratio: 1100 / 820;
      width: 100%;
    }

    .galaxy-list {
      display: none;
    }
  }

  /* Each cluster spans the canvas so its label can reach its own stars. The
     container is pointer-transparent; its children re-enable pointers, so the
     overlapping boxes never steal a hover from each other. */
  .cluster {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* non-scaling-stroke in the markup: the viewBox is stretched to the element,
     so a scaled stroke would be thicker horizontally than vertically. */
  .lines line {
    stroke: var(--spec);
    stroke-width: 0.75;
    stroke-linecap: round;
    opacity: 0.22;
    transition: opacity var(--duration-state) var(--ease-out);
  }

  /* ── Constellation name ────────────────────────────────────────────── */
  /* Deliberately not a chip: no border, no fill. A box here reads as a button
     and competes with the stars for attention. */
  .cluster-label {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    margin: 0;
    padding: 0.2rem 0.4rem;
    white-space: nowrap;
    pointer-events: auto;
    cursor: default;
  }

  .cname {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    /* Tracking adds space after the last character too; pull it back so the
       name still centres on the constellation. */
    text-indent: 0.3em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--spec) 72%, var(--color-text-subtle));
    transition:
      color var(--duration-state) var(--ease-out),
      text-shadow var(--duration-state) var(--ease-out);
  }

  .desig {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    text-indent: 0.18em;
    /* No opacity dimming here: at this size it drops the designation below
       AA in light mode (measured 2.62:1). The subtle token already carries the
       recede, and it clears AA in both themes. */
    color: var(--color-text-subtle);
  }

  /* ── Stars ─────────────────────────────────────────────────────────── */
  /* The .star element is a zero-size anchor ON the star, so the lines meet the
     dot and not the middle of a word. The name hangs off one side. */
  .star {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .dot {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--r) * 2);
    height: calc(var(--r) * 2);
    transform: translate(-50%, -50%);
    border-radius: var(--radius-full);
    background: var(--spec);
    /* Halo scales with magnitude, so a bright star is bright rather than just
       bigger. */
    box-shadow: 0 0 calc(var(--r) * 3.5) color-mix(in srgb, var(--spec) 60%, transparent);
    pointer-events: auto;
    transition:
      box-shadow var(--duration-state) var(--ease-out),
      transform var(--duration-state) var(--ease-out);
  }

  /* Diffraction spikes on the brightest star of each constellation. Faint, or
     the cross reads as a drawn plus sign rather than as flare. */
  .star[data-bright] .dot::before,
  .star[data-bright] .dot::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in srgb, var(--spec) 80%, transparent),
      transparent
    );
    transition: opacity var(--duration-state) var(--ease-out);
  }

  .star[data-bright] .dot::before {
    width: 38px;
    height: 1.5px;
    transform: translate(-50%, -50%);
  }

  .star[data-bright] .dot::after {
    width: 26px;
    height: 1.5px;
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .name {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--color-text-muted);
    pointer-events: auto;
    transition: color var(--duration-state) var(--ease-out);
  }

  .star[data-side='right'] .name {
    left: calc(var(--r) + 7px);
  }

  .star[data-side='left'] .name {
    right: calc(var(--r) + 7px);
  }

  /* ── Hover: emphasis only, never information ───────────────────────── */
  .star:hover .dot {
    transform: translate(-50%, -50%) scale(1.6);
    box-shadow: 0 0 calc(var(--r) * 8) color-mix(in srgb, var(--spec) 75%, transparent);
  }

  .star:hover .name {
    color: var(--spec);
    text-shadow: 0 0 12px color-mix(in srgb, var(--spec) 50%, transparent);
  }

  /* Hovering the constellation name lights its whole constellation. */
  .cluster:has(.cluster-label:hover) .star .dot {
    transform: translate(-50%, -50%) scale(1.4);
    box-shadow: 0 0 calc(var(--r) * 7) color-mix(in srgb, var(--spec) 70%, transparent);
  }

  .cluster:has(.cluster-label:hover) .star .name {
    color: var(--spec);
  }

  .cluster-label:hover .cname {
    color: var(--spec);
    text-shadow: 0 0 16px color-mix(in srgb, var(--spec) 45%, transparent);
  }

  /* Everything outside the hovered thing recedes. */
  .galaxy:has(.star:hover) .star:not(:hover),
  .galaxy:has(.cluster-label:hover) .cluster:not(:has(.cluster-label:hover)) .star {
    opacity: 0.28;
  }

  .galaxy:has(.star:hover) .cluster-label,
  .galaxy:has(.cluster-label:hover)
    .cluster:not(:has(.cluster-label:hover))
    .cluster-label {
    opacity: 0.3;
  }

  .galaxy:has(.star:hover) .lines line,
  .galaxy:has(.cluster-label:hover) .lines line {
    opacity: 0.08;
  }

  .galaxy:has(.cluster-label:hover) .cluster-lines:hover line {
    opacity: 0.5;
  }

  .star,
  .cluster-label {
    transition: opacity var(--duration-state) var(--ease-out);
  }

  /* ── Narrow screens: the plain grouped list ────────────────────────── */
  .galaxy-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.75rem 2.5rem;
  }

  .list-group {
    border-left: 2px solid color-mix(in srgb, var(--spec) 55%, transparent);
    padding-left: 1rem;
  }

  h3 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--spec);
    margin: 0 0 0.7rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.9;
    color: var(--color-text-muted);
  }
</style>

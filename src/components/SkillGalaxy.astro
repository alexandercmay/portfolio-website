---
import { TECH, type TechKey } from '../../content/taxonomy'

interface Props {
  groups: { category: string; items: readonly TechKey[] }[]
}
const { groups } = Astro.props

/**
 * Skills as star clusters — one constellation per category.
 *
 * Positions are computed HERE, at build time, and baked into inline styles.
 * Nothing is calculated in the browser, so this ships zero JavaScript like
 * everything else.
 *
 * Accessibility contract:
 *  - Every skill NAME is always visible. Hover only adds glow and emphasis;
 *    it never reveals information. Hover-gated content would exclude keyboard
 *    and touch users outright.
 *  - DOM order stays logical (category, then items in declared order) even
 *    though the visual placement is scattered — a screen reader reads the
 *    grouped list, not the scatter.
 *  - Below 60rem the whole thing falls back to a plain grouped list, because
 *    a scattered galaxy on a phone is unreadable.
 *  - The constellation lines are decorative and aria-hidden.
 *
 * Known cost: a scatter is harder to scan than a column. /resume keeps the
 * clean grouped list so a scannable version of this information always exists.
 */

/** Deterministic hash → stable positions across builds. */
function hash(s: string): number {
  let h = 2166136261
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i)
    h = Math.imul(h, 16777619)
  }
  return (h >>> 0) / 4294967295
}

/*
 * Layout is solved in PIXELS at build time, then converted to percentages.
 *
 * The first version scattered stars on a jittered ring and produced eleven
 * overlapping label pairs. Because the labels are monospace their widths are
 * exactly predictable, so the boxes can be laid out properly instead of hoped
 * at: place on a ring, then relax overlaps with a few dozen iterations of
 * pairwise repulsion.
 */
const W = 1100
const H = 760 // taller than 16/9: five clusters need vertical room to separate
const CHAR = 8.4 // --text-sm in JetBrains Mono, px per character
const BOX_H = 28
const PAD = 30 // dot + gap + horizontal padding

/*
 * Two margins: same-cluster pairs may sit close, different-cluster pairs are
 * pushed much further apart.
 *
 * MEASURED CAVEAT: as currently configured this second margin never actually
 * binds. Varying MARGIN_OTHER from 6 to 46 changes the closest cross-cluster
 * distance not at all (208px in every case), because the cohesion pull below
 * keeps nodes near their own centre long before a foreign node gets close.
 *
 * What genuinely separates the clusters is the combination of the cohesion
 * pull, the tighter intra-cluster spread, and centres placed further apart —
 * NOT this margin. It is kept as a safety net for when the skill list grows
 * and clusters get large enough for it to engage.
 */
const MARGIN_SAME = 6
const MARGIN_OTHER = 46

type Node = {
  key: string
  label: string
  cluster: number
  isLabel: boolean
  x: number
  y: number
  w: number
  h: number
}

/** Cluster centres in px. Hand-placed to keep the constellations apart. */
const CENTRES = [
  { x: W * 0.17, y: H * 0.24 },
  { x: W * 0.72, y: H * 0.16 },
  { x: W * 0.82, y: H * 0.62 },
  { x: W * 0.2, y: H * 0.74 },
  { x: W * 0.5, y: H * 0.46 },
]

const nodes: Node[] = []

groups.forEach((group, gi) => {
  const c = CENTRES[gi % CENTRES.length]
  const n = group.items.length
  // Tighter internally than before: a compact cluster reads as one object.
  // The separation now comes from inter-cluster repulsion, not from each
  // cluster sprawling.
  const spread = n === 1 ? 0 : Math.min(52 + n * 9, 118)

  // The category label is part of the collision set, so stars cannot land on
  // top of it.
  nodes.push({
    key: `label-${gi}`,
    label: group.category,
    cluster: gi,
    isLabel: true,
    x: c.x,
    y: c.y - spread * 0.55 - 26,
    w: group.category.length * 7 + 8,
    h: 20,
  })

  group.items.forEach((key, i) => {
    const seed = hash(key)
    const angle = (i / Math.max(n, 1)) * Math.PI * 2 + seed * 0.6
    const rad = spread * (0.62 + seed * 0.38)
    nodes.push({
      key,
      label: TECH[key as TechKey].label,
      cluster: gi,
      isLabel: false,
      x: c.x + Math.cos(angle) * rad,
      y: c.y + Math.sin(angle) * rad * 0.66,
      w: TECH[key as TechKey].label.length * CHAR + PAD,
      h: BOX_H,
    })
  })
})

// Relax overlaps: push each colliding pair apart along the axis of least
// penetration. Deterministic, so the layout is stable across builds.
// A pull back toward the cluster centre, applied each pass, keeps repulsion
// from dissolving the constellations into an even scatter.
for (let iter = 0; iter < 140; iter++) {
  for (let i = 0; i < nodes.length; i++) {
    for (let j = i + 1; j < nodes.length; j++) {
      const a = nodes[i]
      const b = nodes[j]
      const dx = b.x - a.x
      const dy = b.y - a.y
      const sameCluster = a.cluster === b.cluster
      const mx = sameCluster ? MARGIN_SAME : MARGIN_OTHER
      const my = sameCluster ? MARGIN_SAME : MARGIN_OTHER * 0.45
      const ox = (a.w + b.w) / 2 + mx - Math.abs(dx)
      const oy = (a.h + b.h) / 2 + my - Math.abs(dy)
      if (ox <= 0 || oy <= 0) continue

      if (ox < oy) {
        const push = (ox / 2) * (dx < 0 ? -1 : 1)
        a.x -= push
        b.x += push
      } else {
        const push = (oy / 2) * (dy < 0 ? -1 : 1)
        a.y -= push
        b.y += push
      }
    }
  }
  // Cohesion: pull each node gently back toward its cluster centre.
  //
  // This is what actually keeps constellations compact and apart. Measured
  // with it disabled: mean cluster radius grows 57px -> 76px and the closest
  // cross-cluster distance falls 208px -> 187px.
  for (const nd of nodes) {
    const c = CENTRES[nd.cluster % CENTRES.length]
    nd.x += (c.x - nd.x) * 0.012
    nd.y += (c.y - nd.y) * 0.012
  }

  // Keep everything inside the canvas.
  for (const nd of nodes) {
    nd.x = Math.max(nd.w / 2 + 4, Math.min(W - nd.w / 2 - 4, nd.x))
    nd.y = Math.max(nd.h / 2 + 4, Math.min(H - nd.h / 2 - 4, nd.y))
  }
}

const clusters = groups.map((group, gi) => {
  const members = nodes.filter((nd) => nd.cluster === gi)
  const label = members.find((nd) => nd.isLabel)!
  const stars = members
    .filter((nd) => !nd.isLabel)
    .map((nd) => ({
      key: nd.key,
      label: nd.label,
      x: (nd.x / W) * 100,
      y: (nd.y / H) * 100,
      r: 2 + hash(nd.key) * 1.7,
    }))
  // The constellation hub is the centroid of the stars actually placed, so
  // the spokes stay tidy after relaxation moved things.
  const hub = {
    x: stars.reduce((s, n) => s + n.x, 0) / Math.max(stars.length, 1),
    y: stars.reduce((s, n) => s + n.y, 0) / Math.max(stars.length, 1),
  }
  return {
    category: group.category,
    // A catalog designation, the way a real star cluster is labelled. Gives
    // each constellation a distinct identity beyond its colour.
    designation: `NGC ${(gi + 1) * 1147}`,
    label: { x: (label.x / W) * 100, y: (label.y / H) * 100 },
    hub,
    stars,
  }
})
---

<div class="galaxy-wrap">
  {
    /* Desktop: the scatter. Each cluster is its own container spanning the
      canvas, so hovering a category name can light that constellation and
      nothing else. Containers are pointer-transparent; their children are
      not, so the overlapping full-size boxes never steal a hover. */
  }
  <div class="galaxy" aria-hidden="true" data-canvas={`${W}x${H}`}>
    <svg class="lines" viewBox="0 0 100 100" preserveAspectRatio="none">
      {
        clusters.map((c, i) => (
          <g class="cluster-lines" style={`--spec: var(--c-spec-${(i % 5) + 1})`}>
            {c.stars.map((s) => (
              <line x1={c.hub.x} y1={c.hub.y} x2={s.x} y2={s.y} />
            ))}
          </g>
        ))
      }
    </svg>

    {
      clusters.map((c, i) => (
        <div class="cluster" style={`--spec: var(--c-spec-${(i % 5) + 1})`}>
          <p class="cluster-label" style={`left:${c.label.x}%;top:${c.label.y}%`}>
            <span class="desig">{c.designation}</span>
            <span class="cname">{c.category}</span>
            <span class="count">{c.stars.length}</span>
          </p>

          {c.stars.map((s) => (
            <span class="star" style={`left:${s.x}%;top:${s.y}%`}>
              <span class="dot" style={`--r:${s.r.toFixed(2)}px`} />
              <span class="name">{s.label}</span>
            </span>
          ))}
        </div>
      ))
    }
  </div>

  {
    /* The real, readable content. Visible on narrow screens; on wide screens
      it is the screen-reader path while the scatter above is aria-hidden. */
  }
  <div class="galaxy-list">
    {
      groups.map((group, i) => (
        <div class="list-group" style={`--spec: var(--c-spec-${(i % 5) + 1})`}>
          <h3>{group.category}</h3>
          <ul>
            {group.items.map((key) => (
              <li>{TECH[key].label}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</div>

<style>
  /* ── Scatter ───────────────────────────────────────────────────────── */
  .galaxy {
    display: none;
  }

  @media (min-width: 60rem) {
    .galaxy {
      display: block;
      position: relative;
      aspect-ratio: 1100 / 760;
      width: 100%;
    }

    .galaxy-list {
      display: none;
    }
  }

  /* Each cluster spans the canvas so its label can reach its own stars. The
     container is pointer-transparent; its children re-enable pointers, so the
     overlapping boxes never steal a hover from each other. */
  .cluster {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .lines line {
    stroke: var(--spec);
    stroke-width: 0.12;
    opacity: 0.2;
    transition: opacity var(--duration-state) var(--ease-out);
  }

  /* ── Cluster label ─────────────────────────────────────────────────── */
  .cluster-label {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    margin: 0;
    padding: 0.4rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--spec) 30%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    white-space: nowrap;
    pointer-events: auto;
    cursor: default;
    transition:
      border-color var(--duration-state) var(--ease-out),
      box-shadow var(--duration-state) var(--ease-out);
  }

  .desig {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-subtle);
  }

  .cname {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--spec);
    text-shadow: 0 0 14px color-mix(in srgb, var(--spec) 45%, transparent);
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-text-subtle);
  }

  /* ── Stars ─────────────────────────────────────────────────────────── */
  .star {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
    pointer-events: auto;
    cursor: default;
    transition:
      transform var(--duration-state) var(--ease-out),
      opacity var(--duration-state) var(--ease-out),
      background-color var(--duration-state) var(--ease-out);
  }

  .dot {
    width: calc(var(--r) * 2);
    height: calc(var(--r) * 2);
    border-radius: var(--radius-full);
    background: var(--spec);
    box-shadow: 0 0 10px color-mix(in srgb, var(--spec) 55%, transparent);
    flex-shrink: 0;
    transition:
      box-shadow var(--duration-state) var(--ease-out),
      transform var(--duration-state) var(--ease-out);
  }

  .name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--duration-state) var(--ease-out);
  }

  /* ── Hover: emphasis only, never information ───────────────────────── */
  .star:hover {
    transform: translate(-50%, -50%) scale(1.12);
    background: color-mix(in srgb, var(--spec) 12%, transparent);
  }

  .star:hover .dot {
    transform: scale(1.5);
    box-shadow: 0 0 24px color-mix(in srgb, var(--spec) 70%, transparent);
  }

  .star:hover .name {
    color: var(--spec);
    text-shadow: 0 0 12px color-mix(in srgb, var(--spec) 50%, transparent);
  }

  /* Hovering the category name lights its whole constellation. */
  .cluster:has(.cluster-label:hover) .star .dot {
    transform: scale(1.4);
    box-shadow: 0 0 22px color-mix(in srgb, var(--spec) 70%, transparent);
  }

  .cluster:has(.cluster-label:hover) .star .name {
    color: var(--spec);
  }

  .cluster-label:hover {
    border-color: color-mix(in srgb, var(--spec) 70%, transparent);
    box-shadow: 0 0 18px color-mix(in srgb, var(--spec) 30%, transparent);
  }

  /* Everything outside the hovered thing recedes. */
  .galaxy:has(.star:hover) .star:not(:hover),
  .galaxy:has(.cluster-label:hover) .cluster:not(:has(.cluster-label:hover)) .star {
    opacity: 0.3;
  }

  .galaxy:has(.star:hover) .cluster-label,
  .galaxy:has(.cluster-label:hover)
    .cluster:not(:has(.cluster-label:hover))
    .cluster-label {
    opacity: 0.35;
  }

  .galaxy:has(.star:hover) .lines line,
  .galaxy:has(.cluster-label:hover) .lines line {
    opacity: 0.08;
  }

  .galaxy:has(.cluster-label:hover) .cluster-lines:hover line {
    opacity: 0.45;
  }

  .cluster-label {
    transition-property: opacity, border-color, box-shadow;
    transition-duration: var(--duration-state);
    transition-timing-function: var(--ease-out);
  }

  /* ── Narrow screens: the plain grouped list ────────────────────────── */
  .galaxy-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.75rem 2.5rem;
  }

  .list-group {
    border-left: 2px solid color-mix(in srgb, var(--spec) 55%, transparent);
    padding-left: 1rem;
  }

  h3 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--spec);
    margin: 0 0 0.7rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.9;
    color: var(--color-text-muted);
  }
</style>

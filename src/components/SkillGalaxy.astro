---
import { TECH, type TechKey } from '../../content/taxonomy'

interface Props {
  groups: { category: string; items: readonly TechKey[] }[]
}
const { groups } = Astro.props

/**
 * Skills as star clusters — one constellation per category.
 *
 * Positions are computed HERE, at build time, and baked into inline styles.
 * Nothing is calculated in the browser, so this ships zero JavaScript like
 * everything else.
 *
 * Reads as a star chart rather than as a diagram of boxes:
 *  - the CATEGORY is the constellation name — letterspaced small caps, no
 *    border and no background. A bordered chip is a UI control; a
 *    constellation name is a caption on the sky.
 *  - each STAR is labelled with the technology, and the label sits on the side
 *    facing AWAY from the cluster centre, so text radiates outward and the
 *    lines in the middle stay clean
 *  - stars vary in magnitude, and the brightest of each constellation carries
 *    diffraction spikes
 *
 * TWO charts are solved, not one. A landscape sky at 1100x820 for wide
 * viewports, and a portrait one 340px wide with the constellations stacked for
 * narrow ones. Scaling the landscape chart down does not work: positions are
 * percentages so they shrink, but the labels are set in absolute pixels and do
 * not, so every constellation collapses into its own text. Only one chart is
 * ever displayed, and `display: none` takes the other out of the accessibility
 * tree as well, so nothing is announced twice.
 *
 * Accessibility contract:
 *  - The chart IS the content, not decoration. Each constellation is a real
 *    <h3> and a real list, in declared order, so the DOM reads as a grouped
 *    list of skills even though the visual placement is scattered.
 *  - Every skill NAME is always visible. Hover only adds glow and emphasis;
 *    it never reveals information. Hover-gated content would exclude keyboard
 *    and touch users outright.
 *  - The star catalog underneath is the same skills as a plain column, for
 *    anyone who would rather scan than read a sky. It is collapsed by default,
 *    which is only acceptable because the chart above it is semantic: gating
 *    the skills themselves behind a disclosure would be the same mistake as
 *    gating them behind hover.
 *  - The constellation lines are decorative and aria-hidden.
 */

/** Deterministic hash → stable positions across builds. */
function hash(s: string): number {
  let h = 2166136261
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i)
    h = Math.imul(h, 16777619)
  }
  return (h >>> 0) / 4294967295
}

const CHAR = 7.2 // --text-xs in JetBrains Mono, px per character
const BOX_H = 22
const PAD = 18 // dot + gap
const MARGIN = 16

type Node = {
  key: string
  label: string
  cluster: number
  x: number
  y: number
  w: number
  h: number
  /**
   * Where the collision box sits relative to (x, y).
   *
   * (x, y) is the STAR itself — the point lines terminate at — but the box
   * that must not overlap anything also contains the name, which hangs off one
   * side. Keeping the two separate is what stopped the lines from stopping
   * short in the middle of a word.
   */
  ox: number
  /** -1 label to the left of the star, +1 to the right. */
  side: number
  r: number
}

type Chart = {
  name: string
  /** Canvas the layout is solved in, in px. */
  w: number
  h: number
  /** Cluster territories, one per category. */
  centres: { x: number; y: number }[]
  /** Cap on how far a star may sit from its own cluster's centre. */
  maxR: (cluster: number) => number
  /**
   * Whether constellation names are relaxed against the stars after placement.
   *
   * Only on a canvas with room to move them. On the portrait chart a name like
   * "Backend & infrastructure" is 267px wide against a 340px canvas, so it
   * overlaps essentially every star in its band and relaxation shoves it clean
   * out of the band and up against the constellation above. There, reserved
   * headroom does the job instead.
   */
  relaxLabels: boolean
  /** Seed ring size for a cluster of n stars, before relaxation. */
  spread: (n: number) => number
  /** Ring aspect — portrait clusters are taller than they are wide. */
  ring: { x: number; y: number }
  /** How far above its stars a constellation name sits. */
  labelGap: number
  /**
   * What the name is placed relative to.
   *
   * 'box' centres it over the cluster's whole bounding box, which is right in
   * open sky. 'top-star' pins it directly above the cluster's topmost STAR,
   * which is what a stacked chart needs: the bounding box of a narrow band is
   * dominated by the widest skill name in it, and centring on that can leave
   * the constellation's title floating nearer to the constellation above it
   * than to its own — measured, 55px away from a neighbour's star and 68px
   * from its own.
   */
  labelAnchor: 'box' | 'top-star'
  /** Cap on the name's collision width. Wrapped names are not one line wide. */
  labelMaxW: number
}

/** Constellation name width: 11px mono at 0.3em tracking, px per character. */
const LABEL_CHAR = 9.9

/*
 * Layout is solved in PIXELS at build time, then converted to percentages.
 *
 * Three rewrites, and the first two failed in ways that measurement missed:
 *
 *  1. Jittered rings, no relaxation      -> 11 overlapping labels
 *  2. Global relaxation + cohesion pull  -> clusters INTERLEAVED, and labels
 *     drifted away from their own stars entirely
 *
 * The second failure is the instructive one. "Minimum distance between stars
 * of different clusters" stayed healthy while constellations were threaded
 * through each other, because that metric cannot see interleaving at all. A
 * label sat over a foreign cluster's stars and the numbers looked fine.
 *
 * So the layout is TERRITORIAL rather than emergent:
 *
 *   - cluster centres are placed far apart by hand, which is what actually
 *     prevents interleaving (measured: removing the radius clamp changes
 *     nothing on the landscape chart; moving the centres together produces 13
 *     intruders immediately)
 *   - a radius clamp caps how far a star may sit from its own centre
 *   - labels are placed AFTER the stars settle, from each cluster's actual
 *     bounding box, so a label can never drift away from its own stars
 *   - only then are labels relaxed against the stars, with the stars pinned
 */
const LANDSCAPE: Chart = {
  name: 'landscape',
  w: 1100,
  h: 820,
  // A 3-over-2 arrangement. Centres are >340px apart horizontally and >370px
  // vertically, comfortably more than 2 * maxR, so territories cannot touch.
  // These positions are load-bearing: they, not the radius clamp, are what
  // keeps constellations from threading through each other.
  centres: [
    { x: 1100 * 0.17, y: 820 * 0.23 },
    { x: 1100 * 0.5, y: 820 * 0.21 },
    { x: 1100 * 0.84, y: 820 * 0.26 },
    { x: 1100 * 0.24, y: 820 * 0.73 },
    { x: 1100 * 0.63, y: 820 * 0.74 },
  ],
  maxR: () => 152,
  spread: (n) => (n === 1 ? 0 : Math.min(0.52 * 152 + n * 9, 152 * 0.82)),
  ring: { x: 1, y: 0.74 },
  labelGap: 40,
  relaxLabels: true,
  labelAnchor: 'box',
  labelMaxW: Infinity,
}

/*
 * The portrait chart.
 *
 * 340px wide because that is roughly what a 375px phone leaves after the
 * page's padding, and it is capped there rather than stretching on a wider
 * phone or a tablet — the labels are absolutely sized, so a stretched canvas
 * only pulls the stars apart and strands the text in the gaps.
 *
 * At this width one label can be more than half the canvas ("Event-Driven
 * Microservices" is 198px with its dot), so clusters cannot spread sideways.
 * Each gets a tall band instead, which is why the seed ring is squashed
 * horizontally and stretched vertically here.
 *
 * Here the radius clamp is doing real work rather than sitting dormant: it is
 * sized per cluster from that cluster's own band, so a constellation
 * physically cannot leave its band. That is what makes the headroom between
 * bands reserved space, which is in turn what lets the names be placed without
 * relaxing them against the stars.
 */
const PORTRAIT_W = 340
const PORTRAIT_TOP = 26
const PORTRAIT_LABEL = 88 // reserved headroom above each band, for its name
const PORTRAIT_BANDS = groups.map((g) => Math.max(150, g.items.length * 32))

const PORTRAIT: Chart = {
  name: 'portrait',
  w: PORTRAIT_W,
  h:
    PORTRAIT_TOP * 2 +
    PORTRAIT_BANDS.reduce((sum, band) => sum + band + PORTRAIT_LABEL, 0),
  centres: PORTRAIT_BANDS.map((band, i) => ({
    // Alternate the horizontal bias so the stack does not read as a column of
    // identical blobs.
    x: PORTRAIT_W * (i % 2 === 0 ? 0.46 : 0.54),
    y:
      PORTRAIT_TOP +
      PORTRAIT_BANDS.slice(0, i).reduce((s, b) => s + b + PORTRAIT_LABEL, 0) +
      PORTRAIT_LABEL +
      band / 2,
  })),
  // Sized from each cluster's own band, so no constellation can reach out of
  // it and into the headroom that the name above it is relying on.
  maxR: (gi) => PORTRAIT_BANDS[gi % PORTRAIT_BANDS.length] / 2 - 8,
  spread: (n) => (n === 1 ? 0 : Math.min(34 + n * 9, 104)),
  ring: { x: 0.52, y: 1.15 },
  labelGap: 40,
  relaxLabels: false,
  labelAnchor: 'top-star',
  // Portrait names wrap (see .galaxy[data-chart='portrait'] .cluster-label), so
  // the widest is nowhere near its one-line width. Without this cap the
  // canvas clamp shoves a long name far off its own constellation.
  labelMaxW: 188,
}

/**
 * The figure layer.
 *
 * Star atlases draw the constellation twice: the stick figure joining the
 * actual stars, and — engraved faintly behind it — the thing the constellation
 * is NAMED for. Crucially the drawing never matches the stars. Orion's figure
 * is a man with a club; Orion's stars are an hourglass. The picture is laid
 * over the sky, not derived from it.
 *
 * So these are laid over, not derived: nothing here constrains where a star
 * goes or how many there are, which is the whole reason this approach is safe.
 * Adding a skill cannot break a drawing.
 *
 * Each is a REAL constellation, and each is a real instrument — Lacaille
 * spent the 1750s filling the southern sky with the tools on his desk, so
 * there is already a shield, an easel, a furnace and a telescope up there. The
 * mapping is doing actual work rather than being clip art with a space theme:
 *
 *   Languages                → Lyra, the lyre        (the instrument of speech)
 *   AI systems               → Telescopium           (seeing further than you can)
 *   Backend & infrastructure → Fornax, the furnace   (the thing burning underneath)
 *   Frontend                 → Pictor, the easel     (the surface being painted)
 *   Security                 → Scutum, the shield
 *
 * They are deliberately unlabelled. Naming them would put a second caption
 * under every constellation, which is exactly the clutter the NGC designations
 * were removed for. The rationale lives here instead.
 *
 * Drawn in a 100x100 box, stroked only, and scaled to the constellation with
 * `meet` so nothing is ever distorted to fit.
 */
const FIGURES: Record<string, string> = {
  // Lyra — soundbox, two arms, the yoke across them, and the strings.
  // The arms have to bow OUTWARD before they rise: curved inward they meet at
  // the top and the whole thing reads as a closed almond, not an instrument.
  Languages: [
    'M41 79C46 85 54 85 59 79',
    'M41 79C27 65 25 44 37 24',
    'M59 79C73 65 75 44 63 24',
    'M34 27H66',
    'M44 29V80',
    'M50 29V83',
    'M56 29V80',
  ].join(''),

  // Telescopium — a tube on a pillar mount, over a tripod.
  'AI systems': [
    'M27 60 62 25 72 35 37 70Z',
    'M24 57 31 64',
    'M47 55V64',
    'M47 64 33 88',
    'M47 64 61 88',
    'M47 64V85',
  ].join(''),

  // Fornax — a brazier: rim, bowl, stand, and what is burning in it.
  'Backend & infrastructure': [
    'M26 51H74',
    'M31 51 39 71H61L69 51',
    'M50 71V82',
    'M35 86H65',
    'M50 48C43 39 45 31 50 23C55 31 57 39 50 48Z',
  ].join(''),

  // Pictor — a canvas on an easel.
  Frontend: [
    'M28 19H72V54H28Z',
    'M34 54 27 87',
    'M66 54 73 87',
    'M50 54V81',
    'M31 70H69',
  ].join(''),

  // Scutum — a heater shield, quartered.
  Security: [
    'M26 19H74V46C74 66 62 78 50 87C38 78 26 66 26 46Z',
    'M50 19V87',
    'M27 45H73',
  ].join(''),
}

/** Centre of a node's collision box (the star plus its outward-hanging name). */
const bx = (n: Node) => n.x + n.ox

/**
 * Constellation lines = the Euclidean minimum spanning tree of the cluster.
 *
 * The version before this drew spokes from a hub, which is how you draw a
 * bicycle wheel, not a constellation: every star pointed at the same middle
 * and the result read as an asterisk. An MST connects each star to its nearest
 * already-connected neighbour, which is exactly the chain-of-nearest-stars
 * shape real star charts use — and it stays inside its own territory for free,
 * since the nearest neighbour of a star is always one of its own.
 */
function spanningTree(nodes: Node[]): [Node, Node][] {
  const edges: [Node, Node][] = []
  if (nodes.length < 2) return edges

  const inTree = [nodes[0]]
  const rest = nodes.slice(1)
  while (rest.length > 0) {
    let best = Infinity
    let from = inTree[0]
    let at = 0
    for (const a of inTree) {
      for (let k = 0; k < rest.length; k++) {
        const d = Math.hypot(a.x - rest[k].x, a.y - rest[k].y)
        if (d < best) {
          best = d
          from = a
          at = k
        }
      }
    }
    const [to] = rest.splice(at, 1)
    edges.push([from, to])
    inTree.push(to)
  }
  return edges
}

/** Push overlapping boxes apart along the axis of least penetration. */
function separate(
  chart: Chart,
  movable: Node[],
  fixed: Node[],
  passes: number,
  clamp = true,
) {
  for (let iter = 0; iter < passes; iter++) {
    for (let i = 0; i < movable.length; i++) {
      for (let j = 0; j < movable.length + fixed.length; j++) {
        const a = movable[i]
        const b = j < movable.length ? movable[j] : fixed[j - movable.length]
        if (a === b) continue
        const dx = bx(b) - bx(a)
        const dy = b.y - a.y
        const ox = (a.w + b.w) / 2 + MARGIN - Math.abs(dx)
        const oy = (a.h + b.h) / 2 + MARGIN - Math.abs(dy)
        if (ox <= 0 || oy <= 0) continue
        const bMovable = j < movable.length
        if (ox < oy) {
          const push = (ox / (bMovable ? 2 : 1)) * (dx < 0 ? -1 : 1)
          a.x -= push
          if (bMovable) b.x += push
        } else {
          const push = (oy / (bMovable ? 2 : 1)) * (dy < 0 ? -1 : 1)
          a.y -= push
          if (bMovable) b.y += push
        }
      }
    }

    for (const nd of movable) {
      if (clamp) {
        const c = chart.centres[nd.cluster % chart.centres.length]
        const maxR = chart.maxR(nd.cluster)
        const dx = nd.x - c.x
        const dy = nd.y - c.y
        const d = Math.hypot(dx, dy)
        if (d > maxR) {
          nd.x = c.x + (dx / d) * maxR
          nd.y = c.y + (dy / d) * maxR
        }
      }
      // Clamp the BOX to the canvas, then solve back for the star.
      nd.x = Math.max(
        nd.w / 2 + 4 - nd.ox,
        Math.min(chart.w - nd.w / 2 - 4 - nd.ox, nd.x),
      )
      nd.y = Math.max(nd.h / 2 + 4, Math.min(chart.h - nd.h / 2 - 4, nd.y))
    }
  }
}

function solve(chart: Chart) {
  const stars: Node[] = []

  groups.forEach((group, gi) => {
    const c = chart.centres[gi % chart.centres.length]
    const n = group.items.length
    // Fill the territory rather than hugging the centre — an early pass read
    // as a tight knot.
    const spread = chart.spread(n)

    group.items.forEach((key, i) => {
      const seed = hash(key)
      const angle = (i / Math.max(n, 1)) * Math.PI * 2 + seed * 0.7
      const rad = spread * (0.68 + seed * 0.32)
      const label = TECH[key as TechKey].label
      // Names point away from the cluster centre, so the constellation lines
      // run through open space instead of through text.
      const side = Math.cos(angle) >= 0 ? 1 : -1
      const boxW = label.length * CHAR + PAD
      stars.push({
        key,
        label,
        cluster: gi,
        x: c.x + Math.cos(angle) * rad * chart.ring.x,
        y: c.y + Math.sin(angle) * rad * chart.ring.y,
        w: boxW,
        h: BOX_H,
        ox: (side * boxW) / 2,
        side,
        // Magnitude. Skewed small so a few stars read as bright rather than
        // all of them reading as medium — an even spread looks like a scatter
        // plot.
        r: 1.6 + Math.pow(seed, 1.5) * 2.9,
      })
    })
  })

  separate(chart, stars, [], 120)

  /*
   * Labels last, derived from where the stars actually ended up. Placing them
   * beforehand is what let a label drift away from its own constellation.
   */
  const labels: Node[] = groups.map((group, gi) => {
    const mine = stars.filter((s) => s.cluster === gi)
    const top = mine.reduce((a, b) => (b.y < a.y ? b : a))
    const minX = Math.min(...mine.map((s) => bx(s) - s.w / 2))
    const maxX = Math.max(...mine.map((s) => bx(s) + s.w / 2))
    const w = Math.min(
      Math.max(group.category.length * LABEL_CHAR, 92) + 20,
      chart.labelMaxW,
    )
    const anchorX = chart.labelAnchor === 'top-star' ? top.x : (minX + maxX) / 2
    return {
      key: `label-${gi}`,
      label: group.category,
      cluster: gi,
      // Kept on the canvas, but never further from its own topmost star than
      // the clamp forces it to be.
      x: Math.max(w / 2 + 4, Math.min(chart.w - w / 2 - 4, anchorX)),
      y: top.y - top.h / 2 - chart.labelGap,
      w,
      h: 40,
      ox: 0,
      side: 1,
      r: 0,
    }
  })

  // Stars are pinned; only labels move. Skipped where the canvas is too narrow
  // for a name to have anywhere to go — see Chart.relaxLabels.
  if (chart.relaxLabels) separate(chart, labels, stars, 60, false)

  return groups.map((group, gi) => {
    const mine = stars.filter((s) => s.cluster === gi)
    const label = labels[gi]

    /*
     * The figure's box: a SQUARE on the constellation's centre, sized from its
     * longest side so the drawing is never squashed by a cluster that happens
     * to be wide or tall — the portrait chart's bands are far taller than they
     * are wide, and a box that followed the stars exactly would render Pictor
     * as a sliver.
     *
     * Then clamped inside the canvas, because the figure is an absolutely
     * positioned child and one hanging off the edge would give the page a
     * horizontal scrollbar for the sake of a decoration nobody can see.
     */
    const sx0 = Math.min(...mine.map((s) => s.x))
    const sx1 = Math.max(...mine.map((s) => s.x))
    const sy0 = Math.min(...mine.map((s) => s.y))
    const sy1 = Math.max(...mine.map((s) => s.y))
    const size = Math.min(
      Math.max(sx1 - sx0, sy1 - sy0) * 1.08,
      chart.w * 0.82,
      chart.h * 0.82,
    )
    const fx = Math.max(0, Math.min(chart.w - size, (sx0 + sx1) / 2 - size / 2))
    const fy = Math.max(0, Math.min(chart.h - size, (sy0 + sy1) / 2 - size / 2))
    // Exactly one star per constellation carries diffraction spikes. More than
    // one and the flare stops meaning "this is the bright one".
    const brightest = mine.reduce((a, b) => (b.r > a.r ? b : a))
    return {
      category: group.category,
      figure: FIGURES[group.category],
      figureBox: {
        x: (fx / chart.w) * 100,
        y: (fy / chart.h) * 100,
        w: (size / chart.w) * 100,
        h: (size / chart.h) * 100,
      },
      label: { x: (label.x / chart.w) * 100, y: (label.y / chart.h) * 100 },
      lines: spanningTree(mine).map(([a, b]) => ({
        x1: a.x,
        y1: a.y,
        x2: b.x,
        y2: b.y,
      })),
      stars: mine.map((s) => ({
        key: s.key,
        label: s.label,
        x: (s.x / chart.w) * 100,
        y: (s.y / chart.h) * 100,
        r: s.r,
        side: s.side,
        bright: s === brightest,
      })),
    }
  })
}

const CHARTS = [LANDSCAPE, PORTRAIT].map((chart) => ({
  chart,
  clusters: solve(chart),
}))
---

<div class="galaxy-wrap">
  {
    /* Each cluster is its own container spanning the canvas, so hovering a
      constellation name can light that constellation and nothing else.
      Containers are pointer-transparent; their children are not, so the
      overlapping full-size boxes never steal a hover. */
    CHARTS.map(({ chart, clusters }) => (
      <div
        class="galaxy"
        data-chart={chart.name}
        data-canvas={`${Math.round(chart.w)}x${Math.round(chart.h)}`}
        data-star-box={`${CHAR},${PAD},${BOX_H}`}
        style={`--canvas-w:${Math.round(chart.w)};--canvas-h:${Math.round(chart.h)}`}
      >
        <svg
          class="lines"
          viewBox={`0 0 ${chart.w} ${chart.h}`}
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          {clusters.map((c, i) => (
            <g class="cluster-lines" style={`--spec: var(--c-spec-${(i % 5) + 1})`}>
              {c.lines.map((l) => (
                <line
                  x1={l.x1}
                  y1={l.y1}
                  x2={l.x2}
                  y2={l.y2}
                  vector-effect="non-scaling-stroke"
                />
              ))}
            </g>
          ))}
        </svg>

        {clusters.map((c, i) => (
          <div class="cluster" style={`--spec: var(--c-spec-${(i % 5) + 1})`}>
            {c.figure && (
              <svg
                class="figure"
                viewBox="0 0 100 100"
                preserveAspectRatio="xMidYMid meet"
                aria-hidden="true"
                style={`left:${c.figureBox.x}%;top:${c.figureBox.y}%;width:${c.figureBox.w}%;height:${c.figureBox.h}%`}
              >
                <path d={c.figure} />
              </svg>
            )}

            <h3 class="cluster-label" style={`left:${c.label.x}%;top:${c.label.y}%`}>
              <span class="cname">{c.category}</span>
            </h3>

            {/* role="list" because list-style:none drops list semantics in
                Safari, and this list is the path to the skills. */}
            <ul class="cluster-stars" role="list">
              {c.stars.map((s) => (
                <li
                  class="star"
                  data-side={s.side > 0 ? 'right' : 'left'}
                  data-bright={s.bright ? '' : undefined}
                  style={`left:${s.x}%;top:${s.y}%;--r:${s.r.toFixed(2)}px`}
                >
                  <span class="dot" aria-hidden="true" />
                  <span class="name">{s.label}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ))
  }

  {
    /* The same skills as a column, for anyone who would rather scan than read
      a sky. Collapsed by default — which is only safe because the chart above
      is semantic, so nothing is gated behind opening this. */
  }
  <details class="catalog">
    <summary>
      <span class="caret" aria-hidden="true"></span>
      Star catalog
      <span class="hint">every skill as a plain list</span>
    </summary>
    <div class="catalog-body">
      {
        groups.map((group, i) => (
          <div class="list-group" style={`--spec: var(--c-spec-${(i % 5) + 1})`}>
            <h4>{group.category}</h4>
            <ul>
              {group.items.map((key) => (
                <li>{TECH[key].label}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </details>
</div>

<style>
  /* ── The two charts ────────────────────────────────────────────────── */
  /* Exactly one is ever displayed. `display: none` rather than opacity or
     clipping is deliberate: it takes the other chart out of the accessibility
     tree too, so the skills are never announced twice. */
  .galaxy {
    position: relative;
    width: 100%;
    aspect-ratio: var(--canvas-w) / var(--canvas-h);
  }

  .galaxy[data-chart='landscape'] {
    display: none;
  }

  .galaxy[data-chart='portrait'] {
    /* Never stretched past the width it was solved at: the labels are set in

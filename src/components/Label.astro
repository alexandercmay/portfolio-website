---
/** Uppercase mono micro-label — the "STATUS /" annotation that carries the
    instrument feel. Decorative framing, so the slash is aria-hidden. */
interface Props {
  index?: string
  class?: string
}
const { index, class: className } = Astro.props
---

<p class:list={['label', className]}>
  {index && <span class="idx">{index}</span>}
  {
    index && (
      <span class="slash" aria-hidden="true">
        /
      </span>
    )
  }
  <slot />
</p>

<style>
  .label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin: 0;
  }

  .idx {
    color: var(--color-cyan);
  }

  .slash {
    margin: 0 0.35em;
    opacity: 0.5;
  }
</style>

---
import type { EpochIcon as EpochIconName } from '../../content/resume'

/**
 * Timeline nodes drawn as epochs of the big bang, oldest first: the further
 * down the page (and further back in the career) an entry sits, the earlier
 * the epoch. It gives the rail a direction a plain dot cannot.
 *
 * All six share one geometry so they read as a set rather than six clip-art
 * picks: a 24-unit box, a filled core at the centre of mass, 1.4 stroke, and
 * nothing outside r=9.5 from centre. They are decorative — the role's period
 * and title carry the meaning — so the <svg> is aria-hidden and the caller
 * owns colour via `currentColor`.
 */
interface Props {
  name: EpochIconName
  class?: string
}
const { name, class: className } = Astro.props
---

<svg
  class:list={['epoch', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    /* SINGULARITY — everything, nowhere. A dense core inside one tight ring. */
    name === 'singularity' && (
      <>
        <circle cx="12" cy="12" r="2.2" fill="currentColor" stroke="none" />
        <circle cx="12" cy="12" r="7" opacity="0.85" />
      </>
    )
  }

  {
    /* INFLATION — a point, then space opening in front of it. */
    name === 'inflation' && (
      <>
        <circle cx="5.5" cy="12" r="1.7" fill="currentColor" stroke="none" />
        <path d="M7.75 8.1 A 4.5 4.5 0 0 1 7.75 15.9" />
        <path d="M9.25 5.5 A 7.5 7.5 0 0 1 9.25 18.5" opacity="0.7" />
        <path d="M10.5 3.34 A 10 10 0 0 1 10.5 20.66" opacity="0.4" />
      </>
    )
  }

  {
    /* NUCLEOSYNTHESIS — loose particles binding into something that holds. */
    name === 'nucleosynthesis' && (
      <>
        <path d="M10.75 7.78 L7.25 14.22" opacity="0.8" />
        <path d="M13.25 7.78 L16.75 14.22" opacity="0.8" />
        <path d="M8.6 16.5 L15.4 16.5" opacity="0.8" />
        <circle cx="12" cy="5.5" r="2.1" fill="currentColor" stroke="none" />
        <circle cx="6" cy="16.5" r="2.1" />
        <circle cx="18" cy="16.5" r="2.1" />
      </>
    )
  }

  {
    /* FIRST LIGHT — the universe goes transparent and something is visible. */
    name === 'first-light' && (
      <>
        <circle cx="12" cy="12" r="3" fill="currentColor" stroke="none" />
        <path d="M17 12 L20.5 12 M7 12 L3.5 12 M12 17 L12 20.5 M12 7 L12 3.5" />
        <path
          d="M15.54 8.46 L18.01 5.99 M8.46 8.46 L5.99 5.99 M15.54 15.54 L18.01 18.01 M8.46 15.54 L5.99 18.01"
          opacity="0.55"
        />
      </>
    )
  }

  {
    /* GALAXY — two arms, one core. Structure at scale. */
    name === 'galaxy' && (
      <>
        <path d="M12 12 C 14.5 9.5, 19 10, 19 13.5 C 19 17, 15 19, 12 18" />
        <path d="M12 12 C 9.5 14.5, 5 14, 5 10.5 C 5 7, 9 5, 12 6" />
        <circle cx="12" cy="12" r="2" fill="currentColor" stroke="none" />
      </>
    )
  }

  {
    /* ORBIT — a system: a core, a path, and something running on it. */
    name === 'orbit' && (
      <>
        <ellipse cx="12" cy="12" rx="8.5" ry="4" transform="rotate(-25 12 12)" />
        <circle cx="12" cy="12" r="2.4" fill="currentColor" stroke="none" />
        <circle cx="7.19" cy="17.08" r="1.5" fill="currentColor" stroke="none" />
      </>
    )
  }
</svg>

<style>
  .epoch {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

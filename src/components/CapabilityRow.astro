---
import Chip from './Chip.astro'
import CapabilityGlyph from './CapabilityGlyph.astro'
import { techLabel } from '../../content/taxonomy'
import type { Capability } from '../../content/resume'

/**
 * One capability, drawn as an instrument row: readout, claim, schematic.
 *
 * The three-column shape is the point. A reader scanning the left column alone
 * gets three hard numbers and nothing else, which is the fastest honest
 * summary of the section; a reader who stops gets the claim at deck size and
 * the evidence under it. That only works while every capability HAS a number —
 * see the note on `Capability` in content/resume.ts.
 *
 * Below 56rem the glyph is dropped rather than scaled. It is a schematic with
 * 1.4px strokes and 1.7px vias; at the ~4rem a phone would give it, it stops
 * being a drawing and becomes grey texture beside the text.
 */
interface Props {
  capability: Capability
}
const { capability } = Astro.props
---

<article class="row">
  <div class="metric">
    <span class="value">{capability.metric.value}</span>
    <span class="unit">{capability.metric.unit}</span>
  </div>

  <div class="body">
    <p class="name">{capability.name}</p>
    <p class="claim">{capability.claim}</p>

    <ul class="proof" role="list">
      {capability.proof.map((p) => <li>{p}</li>)}
    </ul>

    <div class="chips">
      {capability.stack.map((key) => <Chip>{techLabel(key)}</Chip>)}
    </div>
  </div>

  <div class="glyph-cell">
    <CapabilityGlyph name={capability.glyph} />
  </div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) 11rem;
    gap: 2rem;
    align-items: start;
    padding: 2.25rem 0;
    border-top: 1px solid var(--color-border);
  }

  .row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  /* ── Readout ──────────────────────────────────────────────────────── */
  .metric {
    text-align: right;
    padding-top: 0.1rem;
  }

  .value {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
    color: var(--color-cyan);
    /* Permitted: this is a display-size readout, not running copy. Blur and
       opacity boosted alongside the Ice-Deep accent swap in tokens.css. */
    text-shadow: 0 0 28px color-mix(in srgb, var(--color-cyan) 38%, transparent);
  }

  .unit {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  /* ── Body ─────────────────────────────────────────────────────────── */
  .name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-cyan);
    margin: 0 0 0.6rem;
  }

  .claim {
    font-family: var(--font-mono);
    font-size: var(--text-deck);
    font-weight: 500;
    line-height: var(--leading-deck);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0;
    max-width: 34ch;
    text-wrap: balance;
  }

  .proof {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    max-width: 68ch;
  }

  .proof li {
    position: relative;
    padding: 0.3rem 0 0.3rem 1.35rem;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  /* The same soft radial-gradient dot as `.marker-list` in global.css (the
     coursework list under Education is the other place it appears) — a
     glowing core fading to transparent, not a flat circle. Duplicated
     rather than sharing the class: `.marker-list > li` and `.proof li` set
     the same padding-left at equal specificity from two different
     stylesheets, and whichever loads second silently wins that fight. A
     literal copy has no such race. This used to be a short horizontal tick
     instead, on the theory that a bullet means "list item" everywhere else
     on the site and a proof line is closer to a timeline entry — but having
     two different bullet shapes on the same page read as an inconsistency,
     not a distinction, so it was reverted. */
  .proof li::before {
    content: '';
    position: absolute;
    left: 0;
    /* Centred on the FIRST LINE's box, not guessed from the em size. The
       `calc(0.62em - 4px)` this replaced was inherited from `.marker-list`,
       which has no padding-top; here the li adds 0.3rem of it, so every dot
       sat ~6px above its line and the whole column read as drifting upward.
       0.3rem = the padding, (1.55em - 9px)/2 = half the leading minus half
       the dot. Both numbers track the padding and line-height above. */
    top: calc(0.3rem + (1.55em - 9px) / 2);
    width: 9px;
    height: 9px;
    background: radial-gradient(
      circle,
      var(--color-cyan) 0 18%,
      color-mix(in srgb, var(--color-cyan) 45%, transparent) 38%,
      transparent 72%
    );
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.25rem;
  }

  /* ── Schematic ────────────────────────────────────────────────────── */
  .glyph-cell {
    opacity: 0.8;
    padding-top: 0.4rem;
    transition: opacity var(--duration-state) var(--ease-out);
  }

  .row:hover .glyph-cell {
    opacity: 1;
  }

  @media (max-width: 56rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .metric {
      text-align: left;
    }

    .glyph-cell {
      display: none;
    }
  }
</style>

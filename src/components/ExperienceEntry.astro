---
import Deck from './Deck.astro'
import StackChips from './StackChips.astro'
import { formatPeriod } from '@/lib/content'
import type { WorkEntry } from '../../content/resume'

interface Props {
  role: WorkEntry
  /** Featured entries lead with the headline; the full list shows highlights. */
  variant?: 'featured' | 'full'
}
const { role, variant = 'featured' } = Astro.props

/**
 * The homepage leads with the headline and a couple of supporting points; the
 * full list lives on /resume. Without this cap the "Selected" section shows
 * every bullet and the curation does nothing.
 */
const FEATURED_HIGHLIGHTS = 3
const highlights =
  variant === 'featured' ? role.highlights.slice(0, FEATURED_HIGHLIGHTS) : role.highlights
const hidden = role.highlights.length - highlights.length
---

<article class:list={['entry', variant]}>
  <div class="aside">
    <p class="period">{formatPeriod(role.start, role.end)}</p>
    <p class="org">{role.org}</p>
    <p class="title">{role.title}</p>
  </div>

  <div class="body">
    {
      variant === 'featured' ? (
        <Deck>{role.headline}</Deck>
      ) : (
        <p class="headline">{role.headline}</p>
      )
    }

    {
      highlights.length > 0 && (
        <ul class="highlights marker-list" role="list">
          {highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )
    }

    {
      hidden > 0 && (
        <p class="more">
          <a href="/resume">{hidden} more on the full resume &rarr;</a>
        </p>
      )
    }

    {
      /* Only on /resume. The homepage's Experience section sits directly above
        the Skills section, which already lists all 32 technologies — every one
        of the 19 in these chips included — so on that page the chips restated
        what the reader was about to be shown, at the cost of a 19-item block
        under the first entry. A resume is read as a standalone document, so it
        keeps the per-role association. */
      variant === 'full' && <StackChips stack={role.stack} />
    }
  </div>
</article>

<style>
  .entry {
    display: grid;
    grid-template-columns: minmax(9rem, 1fr) minmax(0, 3fr);
    gap: 2rem;
    padding: 2.25rem 0;
  }

  .aside > * {
    margin: 0;
  }

  .period {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-cyan);
    margin-bottom: 0.6rem;
  }

  .org {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
  }

  .title {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .headline {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    margin: 0 0 0.75rem;
    color: var(--color-text);
  }

  /* Marker comes from `.marker-list` in global.css — see the note there.
     Only the spacing is local. */
  .highlights {
    margin: 1rem 0 1.1rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .highlights li {
    margin-bottom: 0.55rem;
  }

  /* The chips used to close every entry. Without them on the homepage the
     last block's own bottom margin would stack onto the entry padding. */
  .body > :last-child {
    margin-bottom: 0;
  }

  .more {
    margin: 0 0 1.1rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .more a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-state) var(--ease-out);
  }

  .more a:hover {
    color: var(--color-cyan);
  }

  @media (max-width: 46rem) {
    .entry {
      grid-template-columns: 1fr;
      gap: 0.9rem;
      padding: 1.75rem 0;
    }

    .aside {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.6rem;
    }

    .period {
      margin-bottom: 0;
    }

    .title {
      margin-top: 0;
    }
  }
</style>

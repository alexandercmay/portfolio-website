---
import Deck from './Deck.astro'
import EpochIcon from './EpochIcon.astro'
import { formatPeriod } from '@/lib/content'
import type { WorkEntry } from '../../content/resume'

/**
 * One role, drawn as a segment of the page's timeline rail.
 *
 * This used to be a two-column entry (period/org aside, prose bullets body)
 * with a 3-bullet cap and a "N more on the full resume" escape hatch. Two
 * problems: the aside column fought the rail for the left edge, and the
 * bullets were resume prose — 30-word sentences nobody reads standing up.
 * Now the meta sits in one line above the headline, the rail owns the left
 * edge, and the body is a dated list of one-line milestones. The cap is gone
 * with it: nine short milestones scan faster than three long ones, so there
 * is nothing left to truncate.
 *
 * The `variant` prop went too — /resume is a PDF embed, so nothing ever asked
 * for the 'full' rendering.
 */
interface Props {
  role: WorkEntry
}
const { role } = Astro.props
---

<article class="entry">
  <span class="node" aria-hidden="true">
    <EpochIcon name={role.icon} />
  </span>

  <div class="meta">
    <span class="period">{formatPeriod(role.start, role.end)}</span>
    <span class="sep" aria-hidden="true"></span>
    <span class="org">{role.org}</span>
    <span class="title">{role.title}</span>
  </div>

  <Deck>{role.headline}</Deck>

  {
    role.milestones.length > 0 && (
      <ol class="milestones" role="list">
        {role.milestones.map((m) => (
          <li>
            <span class="when">{m.when}</span>
            <span class="what">{m.text}</span>
          </li>
        ))}
      </ol>
    )
  }
</article>

<style>
  .entry {
    position: relative;
    padding: 0.35rem 0 3.25rem;
  }

  .entry:last-child {
    padding-bottom: 0.5rem;
  }

  /* ── Rail node ────────────────────────────────────────────────────── */

  /* `--rail-gutter` is set on .timeline by the page that owns the rail; the
     fallback keeps the node on the line if this is ever dropped somewhere
     without one. The disc is opaque so it punches through the rail rather
     than sitting on top of a visible line. */
  .node {
    position: absolute;
    /* The rail is .timeline::after — the LAST child in paint order, so without
       a z-index it draws its cyan gradient straight through every icon. The
       node needs to sit above it; .timeline is `position: relative` with
       `z-index: auto`, so it opens no stacking context and a plain 1 here is
       enough. */
    z-index: 1;
    top: 0;
    left: calc(-1 * var(--rail-gutter, 2.75rem) + 1px);
    transform: translateX(-50%);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    color: var(--color-cyan);
  }

  /* The glow is on the node, not the icon: a drop-shadow on six different
     stroke paths costs a filter pass per icon and reads as blur, not light. */
  .entry:hover .node {
    border-color: var(--color-cyan);
    box-shadow: var(--glow-cyan);
  }

  .node {
    transition:
      border-color var(--duration-state) var(--ease-out),
      box-shadow var(--duration-state) var(--ease-out);
  }

  /* ── Meta line ────────────────────────────────────────────────────── */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem;
    margin-bottom: 0.85rem;
  }

  .period {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-cyan);
  }

  .sep {
    width: 3px;
    height: 3px;
    border-radius: var(--radius-full);
    background: var(--color-text-subtle);
  }

  .org {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
  }

  .title {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* ── Milestones ───────────────────────────────────────────────────── */
  /* On a wide viewport the entry is the full content column — over 1000px —
     and a one-line milestone set across all of it stops being a line and
     becomes a scan across the screen. The cap keeps the ragged right edge
     close enough to the stamp column that the eye can travel back. */
  .milestones {
    list-style: none;
    margin: 1.35rem 0 0;
    padding: 0;
    max-width: 68ch;
  }

  /*
    The stamp column is fixed rather than auto so every `when` in the section
    lines up, including across roles — that shared edge is what makes the list
    read as a timeline instead of as a definition list. 4.75rem holds '2024—26'
    in mono at --text-xs; anything longer wraps and breaks the row.
  */
  .milestones li {
    display: grid;
    grid-template-columns: 4.75rem 1fr;
    gap: 0.9rem;
    padding: 0.42rem 0;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .when {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-subtle);
    /* Optical baseline match against the larger .what text beside it. */
    padding-top: 0.15em;
    white-space: nowrap;
  }

  .what {
    position: relative;
    color: var(--color-text-muted);
    padding-left: 0.95rem;
  }

  /* A tick on the stamp/text boundary — a scale mark, not a bullet. It is
     deliberately not `.marker-list`'s radial dot: that marker means "list
     item" everywhere else on the site, and these rows are timeline ticks. */
  .what::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.4rem;
    height: 1px;
    background: var(--color-border);
  }

  .entry:hover .what::before {
    background: color-mix(in srgb, var(--color-cyan) 60%, transparent);
  }

  @media (max-width: 46rem) {
    .node {
      width: 1.85rem;
      height: 1.85rem;
      padding: 0.34rem;
    }

    .milestones li {
      grid-template-columns: 3.9rem 1fr;
      gap: 0.6rem;
    }

    .what {
      padding-left: 0.7rem;
    }
  }

  /*
    Under ~30rem the stamp column costs about a fifth of the text measure and
    the one-line milestones start wrapping to four lines each. The shared
    stamp edge is worth less than the measure at that width, so the row stacks
    and the tick moves to the stamp.
  */
  @media (max-width: 30rem) {
    .milestones li {
      display: block;
      padding: 0.5rem 0;
    }

    .when {
      display: block;
      padding: 0 0 0.15rem 0.95rem;
      position: relative;
    }

    .when::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.62em;
      width: 0.4rem;
      height: 1px;
      background: var(--color-border);
    }

    /* `display: block` is load-bearing, not tidiness. In the grid layout
       above, .what is a grid item and so blockified for free; once the row
       stacks it falls back to an inline box, where `padding-left` applies
       only to the first line box and every wrapped line hangs out to the
       left of the one above it. */
    .what {
      display: block;
      padding-left: 0.95rem;
    }

    .what::before {
      display: none;
    }
  }
</style>

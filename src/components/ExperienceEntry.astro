---
import Deck from './Deck.astro'
import StackChips from './StackChips.astro'
import { formatPeriod } from '@/lib/content'
import type { WorkEntry } from '../../content/resume'

interface Props {
  role: WorkEntry
  /** Featured entries lead with the headline; the full list shows highlights. */
  variant?: 'featured' | 'full'
}
const { role, variant = 'featured' } = Astro.props

/**
 * The homepage leads with the headline and a couple of supporting points; the
 * full list lives on /resume. Without this cap the "Selected" section shows
 * every bullet and the curation does nothing — which is exactly what it did
 * before this line existed.
 */
const FEATURED_HIGHLIGHTS = 3
const highlights =
  variant === 'featured' ? role.highlights.slice(0, FEATURED_HIGHLIGHTS) : role.highlights
const hidden = role.highlights.length - highlights.length
---

<article class:list={['entry', variant]}>
  <div class="aside">
    <p class="period">{formatPeriod(role.start, role.end)}</p>
    <p class="org">{role.org}</p>
    <p class="title">{role.title}</p>
  </div>

  <div class="body">
    {
      variant === 'featured' ? (
        <Deck>{role.headline}</Deck>
      ) : (
        <p class="headline">{role.headline}</p>
      )
    }

    {
      highlights.length > 0 && (
        <ul class="highlights">
          {highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )
    }

    {
      hidden > 0 && (
        <p class="more">
          <a href="/resume">{hidden} more on the full resume &rarr;</a>
        </p>
      )
    }

    <StackChips stack={role.stack} />
  </div>
</article>

<style>
  /* Asymmetric: quiet metadata in a narrow column, content in a wide one.
     That asymmetry is a large part of what reads as designed rather than
     stacked. */
  .entry {
    display: grid;
    grid-template-columns: minmax(9rem, 1fr) minmax(0, 3fr);
    gap: 2rem;
    padding: 2.5rem 0;
  }

  .aside > * {
    margin: 0;
  }

  .period {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin-bottom: 0.5rem;
  }

  .org {
    font-size: var(--text-base);
    color: var(--color-text);
  }

  .title {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .headline {
    font-size: var(--text-lg);
    margin: 0 0 0.75rem;
    color: var(--color-text);
  }

  .highlights {
    margin: 1rem 0 1.1rem;
    padding-left: 1.1rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .highlights li {
    margin-bottom: 0.4rem;
  }

  .full .highlights {
    margin-top: 0.6rem;
  }

  .more {
    margin: 0 0 1.1rem;
    font-size: var(--text-sm);
  }

  .more a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .more a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 46rem) {
    .entry {
      grid-template-columns: 1fr;
      gap: 0.9rem;
      padding: 2rem 0;
    }

    .aside {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.6rem;
    }

    .period {
      margin-bottom: 0;
    }
  }
</style>

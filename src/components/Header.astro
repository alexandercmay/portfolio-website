---
import ThemeToggle from './ThemeToggle.astro'

const nav = [
  { href: '/projects', label: 'projects' },
  { href: '/resume', label: 'resume' },
  { href: '/about', label: 'about' },
]

const path = Astro.url.pathname
---

<header>
  <div class="inner">
    <a class="wordmark" href="/">
      {
        /*
          The mark: a pulsing four-point star, deliberately NOT drawn with
          the corona/spikes/core construction SectionHeader's own star marker
          uses on section 01 ("What I build") — that earlier version was the
          exact same icon repeated in two places on one page, and got
          replaced for it. It in turn replaced a bracket-wrapped
          [ALEXANDER MAY] lockup, the piece of header chrome that referenced
          nothing else on the page at all.

          A single filled, straight-edged 8-vertex polygon (4 outer points,
          4 inner) rather than the smooth bezier curves an earlier sparkle
          draft used — angular facets are correct-by-construction in a way
          hand-typed curve math is not, and they hold their shape at the 17px
          this actually renders at, which was verified with a repeated strip
          at true render size before this was picked over three other
          candidates (a bare point of light, a six-ray asterisk, a two-body
          pair) that were built alongside it for exactly that comparison.

          Two heavier builds were tried and reverted before any of these
          four: a spinning-cross version, then a four-planet orbital system
          with a ringed outermost body, both too busy for chrome that sits on
          every page permanently rather than a one-shot hero moment.
        */
      }
      <svg class="star" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 2 15 9 22 12 15 15 12 22 9 15 2 12 9 9Z" fill="currentColor" />
      </svg>
      Alexander May
    </a>

    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={
                  path === item.href || path.startsWith(item.href + '/')
                    ? 'page'
                    : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: var(--container-content);
    margin: 0 auto;
    padding: 1rem 1.5rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text);
    margin-right: auto;
    /* Must not wrap — a two-line wordmark doubles the header height and eats
       the vertical budget the hero's scan test depends on. */
    white-space: nowrap;
  }

  .star {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--color-cyan);
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--color-cyan) 55%, transparent));
    flex-shrink: 0;
  }

  /* Same pulse rhythm as the hero's `.live` status dot (2.4s), so the two
     signals on the page read as the same kind of thing rather than two
     unrelated animations competing for attention. Base state is the fully
     lit glow with no animation — reduced motion loses the pulse, never the
     mark itself. */
  @media (prefers-reduced-motion: no-preference) {
    .star {
      animation: pulse-mark 2.4s var(--ease-out) infinite;
    }
  }

  @keyframes pulse-mark {
    0%,
    100% {
      filter: drop-shadow(0 0 5px color-mix(in srgb, var(--color-cyan) 55%, transparent));
    }
    50% {
      filter: drop-shadow(0 0 9px color-mix(in srgb, var(--color-cyan) 80%, transparent));
    }
  }

  nav ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-state) var(--ease-out);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-cyan);
  }

  @media (max-width: 30rem) {
    .inner {
      gap: 0.75rem;
      padding: 0.85rem 1rem;
    }

    .wordmark {
      gap: 0.45rem;
      font-size: var(--text-xs);
    }

    .star {
      width: 0.9rem;
      height: 0.9rem;
    }

    nav a {
      font-size: var(--text-xs);
    }

    nav ul {
      gap: 0.9rem;
    }
  }
</style>

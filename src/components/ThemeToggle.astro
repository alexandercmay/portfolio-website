---
/**
 * Handled by the single delegated inline script in ThemeScript.astro — this
 * component ships no JavaScript of its own.
 *
 * The icons are swapped in CSS using the same three-state logic as the palette
 * (system default, explicit light, explicit dark), so the correct one shows
 * before any script runs.
 */
---

<button type="button" data-theme-toggle aria-label="Switch theme">
  <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
  <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
    <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <path
        d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.1 5.1l1.4 1.4M17.5 17.5l1.4 1.4M18.9 5.1l-1.4 1.4M6.5 17.5l-1.4 1.4"
      ></path>
    </g>
  </svg>
</button>

<style>
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  button:hover {
    color: var(--color-text);
  }

  /* Light (default and explicit): offer the moon. */
  .i-sun {
    display: none;
  }

  /* System dark, unless explicitly overridden to light. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .i-moon {
      display: none;
    }
    :root:not([data-theme='light']) .i-sun {
      display: block;
    }
  }

  /* Explicit choice wins in both directions. */
  :root[data-theme='dark'] .i-moon {
    display: none;
  }
  :root[data-theme='dark'] .i-sun {
    display: block;
  }
  :root[data-theme='light'] .i-moon {
    display: block;
  }
  :root[data-theme='light'] .i-sun {
    display: none;
  }
</style>

---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Button from '@/components/Button.astro'
import Rule from '@/components/Rule.astro'
import SectionHeader from '@/components/SectionHeader.astro'
import Label from '@/components/Label.astro'
import CapabilityRow from '@/components/CapabilityRow.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import SkillGalaxy from '@/components/SkillGalaxy.astro'
import { getFeaturedProjects, formatPeriod } from '@/lib/content'
import { resume } from '../../content/resume'

const { basics, work, capabilities, education, skills } = resume

/**
 * The `Where` strip under the capabilities: every role, newest first.
 *
 * Deliberately ALL of them and not the `featured` subset. The strip exists so
 * a reader looking for an employer and a date finds one without leaving the
 * page, and a filtered employment history does that job badly.
 */
const roles = [...work].sort((a, b) => b.start.getTime() - a.start.getTime())

const featuredProjects = await getFeaturedProjects(3)
---

<BaseLayout
  title={`${basics.name} — ${basics.headline}`}
  description={basics.summary}
  wide
>
  {
    /*
    HERO — the scan test.
    Name, headline, and a contact affordance must be visible at 375px without
    scrolling, at full opacity on first paint. No animation, no reveal class,
    nothing that delays it. Everything below this may be as expressive as it
    likes; this may not.
  */
  }
  <section class="hero" aria-label="Introduction">
    <div class="ambient" aria-hidden="true"></div>
    <div class="wrap">
      <Label class="status">
        {
          /*
            Binary pair, in the primary cyan accent rather than the lime
            "live/running" channel tokens.css otherwise reserves for exactly
            this kind of status dot — a deliberate, explicit exception, not
            an oversight; the semantic-channel rule stays intact everywhere
            else on the site.

            The shape needed a bigger box than the plain dot it replaced —
            0.45rem was tuned for a single circle, and two circles at that
            size read as noise, not bodies. 0.9rem is the size this was
            actually verified at (a repeated strip at true render size,
            alongside the header star's candidates) before being picked.
          */
        }
        <svg class="live" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="10" cy="12.5" r="5.3" fill="currentColor"></circle>
          <circle cx="18" cy="8.5" r="2.6" fill="currentColor"></circle>
        </svg>
        Searching for full-stack &amp; AI engineering roles
      </Label>
      <h1>{basics.name}</h1>
      <p class="headline">{basics.headline}</p>
      <p class="summary">{basics.summary}</p>
      <div class="actions">
        <Button href={`mailto:${basics.email}`} transmit>Get in touch</Button>
        <Button href="/alexander-may-resume.pdf" variant="secondary" download>
          Download resume
        </Button>
      </div>
    </div>
  </section>

  <div class="wrap">
    <Rule />

    {
      /* WHAT I BUILD — the heart of the page.
         Capabilities, not a timeline: the reader arrives asking what he can
         do, and the employment history they might also want is one line down
         in the `Where` strip. See the note on `Capability` in resume.ts. */
    }
    <section class="band" aria-labelledby="capabilities">
      <SectionHeader index="01" id="capabilities" title="What I build" />
      <div class="capabilities reveal-stagger">
        {capabilities.map((capability) => <CapabilityRow capability={capability} />)}
      </div>

      {
        /* The employment history, under the claims it evidences. It was tried
           above them, on the theory that "where has he worked" is the second
           thing a reader asks — but read first it front-loads the page with a
           credential nobody has been given a reason to care about yet. Under
           the rows it is what it always was: the receipts. */
      }
      <div class="where reveal">
        <span class="where-label">Where</span>
        {
          roles.map((role) => (
            <span class="where-role">
              <span class="where-org">{role.org}</span>
              <span class="where-title">{role.shortTitle ?? role.title}</span>
              <span class="where-period">{formatPeriod(role.start, role.end)}</span>
            </span>
          ))
        }
        <a class="where-more" href="/resume">Full resume &rarr;</a>
      </div>
    </section>

    {
      /* METRICS — renders nothing at all when there are no real numbers.
        Three invented-sounding figures do more damage than none. */
    }
    <Rule />

    <section class="band reveal" aria-labelledby="work">
      <SectionHeader
        index="02"
        id="work"
        title="Projects"
        href="/projects"
        linkLabel="All projects"
      />
      <div class="projects reveal-stagger">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <Rule />

    <section class="band" aria-labelledby="skills">
      <SectionHeader index="03" id="skills" title="Skills" />
      <div class="reveal-stagger">
        <SkillGalaxy groups={skills} />
      </div>
    </section>

    <Rule />

    <section class="band" aria-labelledby="education">
      <SectionHeader index="04" id="education" title="Education" />

      {
        education.map((e) => (
          <div class="module marks edu-module reveal">
            <div class="module-head">
              <span class="head-dot" aria-hidden="true" />
              {e.institution}
            </div>

            <div class="module-body">
              <div class="edu-top">
                <div>
                  <p class="edu-degree">
                    {e.degree} {e.field}
                  </p>
                  {e.highlights.length > 0 && (
                    <p class="edu-highlights">{e.highlights.join(' · ')}</p>
                  )}
                </div>
                <div class="edu-side">
                  {/* The GPA is the only number in this section, and as one
                      more middot-separated item in `highlights` it read as
                      trivia. It gets the readout treatment the capability
                      metrics get instead: mono, cyan, display size, its own
                      label underneath. */}
                  {e.gpa && (
                    <p class="edu-gpa">
                      <span class="gpa-figure">{e.gpa}</span>
                      <span class="gpa-unit">GPA</span>
                    </p>
                  )}
                  <p class="edu-period">{formatPeriod(e.start, e.end)}</p>
                </div>
              </div>

              {e.coursework && e.coursework.length > 0 && (
                <div class="coursework">
                  <p class="coursework-label">Relevant coursework</p>
                  <ul class="marker-list" role="list">
                    {e.coursework.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        ))
      }
    </section>

    <Rule />

    <section class="band" aria-labelledby="contact">
      <SectionHeader index="05" id="contact" title="Get in touch" />

      {
        /*
          Not a module. Every other section on this page ends in a bordered
          plate with a small mono header, and the contact section arriving as
          one more of those made the page's last screen its least interesting —
          the one place a reader is actually being asked to do something.

          So the dish the "Get in touch" button already carries is drawn here
          at ~15rem instead, transmitting continuously rather than on hover,
          and the copy and the buttons sit inside its beam. The mast, feed and
          base are the button's, scaled 5x into a 170-unit box; the REFLECTOR
          is not — a solid ellipse survives being an icon and does not survive
          being 15rem tall, so it is redrawn as a mesh. Four longer arcs are
          solved around the dish centre at (55.5, 102.5) rather than the
          button's three short ones.

          The dish is aria-hidden. It says nothing the heading and the buttons
          do not already say in text.
        */
      }
      <div class="contact reveal">
        <div class="contact-copy">
          <p class="lead">
            I’m searching for full-stack and AI engineering roles, and I’m always happy to
            talk about the work above. Email is the direct line.
          </p>
          <div class="actions">
            {
              /* No `transmit` here, unlike the hero's. Button.astro's own note
                 says the dish is only for the reach-out action because a page
                 where every button transmits is a page where transmitting
                 means nothing — and inside THIS section that argument turns on
                 itself. The section marker is a dish, the graphic beside this
                 is a dish at 15rem, and a third one at 1.15em on the button
                 made three of them in one screen. The big one already says
                 transmission; the button only has to say the address. */
            }
            <Button href={`mailto:${basics.email}`}>{basics.email}</Button>
            {
              basics.profiles.map((profile) => (
                <Button href={profile.url} variant="secondary">
                  {profile.network}
                </Button>
              ))
            }
          </div>
        </div>

        <div class="dish-cell" aria-hidden="true">
          <div class="dish-wash"></div>
          {
            /* viewBox cropped to the drawing's measured bbox (24,12 → 139,146)
              plus 3 units for the widest stroke. Solving the arcs in a square
              170 box and then displaying that box left ~30% of the graphic as
              empty margin, which just made the dish smaller for no reason. */
          }
          <svg class="big-dish" viewBox="21 9 121 140" focusable="false">
            {
              /* The reflector is the button's solid ellipse with two changes,
                both deliberately small: the fill drops to 0.6 so the starfield
                reads through the bowl, and six panel seams sit in the outer
                annulus with a hub ring closing them off.

                The seams STOP at 0.46 of the radius rather than running the
                full diameter. Full chords through the centre were tried first
                and cut the dish into six equal wedges — it read as a sliced
                pizza, not an antenna. Lines that never converge on a point
                cannot do that, and stopping them at a hub ring is also what a
                real segmented reflector looks like: the centre is one piece,
                the outer ring is panelled.

                Endpoints are solved on the rotated ellipse (rx 29.5, ry 16,
                50°, centre 55.5/102.5) at 60° steps, from 0.46 to 0.97 of the
                radius — 0.97 rather than 1.0 so a seam never pokes through the
                rim stroke. Change the ellipse and every number here has to be
                re-solved; do it in a generator, not by nudging path data. */
            }
            <ellipse
              cx="55.5"
              cy="102.5"
              rx="29.5"
              ry="16"
              transform="rotate(50 55.5 102.5)"
              fill="currentColor"
              fill-opacity="0.6"
              stroke="currentColor"
              stroke-width="2.4"></ellipse>
            <g
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              opacity="0.62"
            >
              <path
                d="M64.2 112.9L73.9 124.4M55.0 111.8L54.4 122.1M46.3 101.4L36.0 100.2M46.8 92.1L37.1 80.6M56.0 93.2L56.6 82.9M64.7 103.6L75.0 104.8"
              ></path>
              <ellipse
                cx="55.5"
                cy="102.5"
                rx="13.6"
                ry="7.4"
                transform="rotate(50 55.5 102.5)"></ellipse>
            </g>
            <path
              d="M55.5 102.5 72.5 88.2"
              stroke="currentColor"
              stroke-width="2.6"
              stroke-linecap="round"
              fill="none"></path>
            <circle cx="74.5" cy="86.5" r="5.4" fill="currentColor"></circle>
            {
              /* Mast and base stay filled. The reflector is the thing that had to
                open up; a hollow mast would only read as an unfinished drawing. */
            }
            <g fill="currentColor" opacity="0.85">
              <path d="M51 104.5 45 134.5h11.5L61 108Z"></path>
              <path d="M35 138h41v7.5H35Z"></path>
            </g>
            <g class="beam" fill="none" stroke="currentColor" stroke-linecap="round">
              <path class="arc" d="M62.4 63.1A40 40 0 0 1 91.8 85.6" stroke-width="3.4"
              ></path>
              <path class="arc" d="M65.1 48.3A55 55 0 0 1 105.3 79.3" stroke-width="3"
              ></path>
              <path class="arc" d="M67.7 33.6A70 70 0 0 1 118.9 72.9" stroke-width="2.6"
              ></path>
              <path class="arc" d="M70.3 18.8A85 85 0 0 1 132.5 66.6" stroke-width="2.2"
              ></path>
            </g>
          </svg>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--container-content);
    margin: 0 auto;
    padding-inline: 1.5rem;
  }

  .education,
  .contact .lead,
  .summary {
    /* Prose sits on the page ground rather than over the grid. */
    position: relative;
  }

  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    isolation: isolate;
    /* The ambient wash bleeds 10% past both sides so its soft edge is never
       visible. Without this it also bleeds past the VIEWPORT: on a 390px
       phone that is 39px of extra document width, which makes the page
       horizontally scrollable and leaves the centred content sitting against
       the left edge with a gap on the right. Reported on iOS Safari; it was
       there in every browser, just less obvious with a visible scrollbar.

       `clip` and not `hidden`: it does the same job without making the hero a
       scroll container. */
    overflow: clip;
    padding: clamp(2.5rem, 8vw, 5rem) 0 clamp(2.5rem, 6vw, 4rem);
  }

  /* No reveal class anywhere in the hero. Name, headline, and contact render
     at full opacity on first paint — the scan test depends on it. */
  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .live {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--color-cyan);
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--color-cyan) 55%, transparent));
    flex-shrink: 0;
  }

  /* Same pulse technique the header star uses — filter on the whole SVG,
     not a box-shadow on a single circle, since a box-shadow can't wrap two
     independent shapes the way this mark needs. Same 2.4s rhythm too, so the
     header mark and this one still read as one family of signal even though
     the shape moved from a plain dot to a paired one. */
  @media (prefers-reduced-motion: no-preference) {
    .live {
      animation: pulse-live 2.4s var(--ease-out) infinite;
    }
  }

  @keyframes pulse-live {
    0%,
    100% {
      filter: drop-shadow(0 0 4px color-mix(in srgb, var(--color-cyan) 55%, transparent));
    }
    50% {
      filter: drop-shadow(0 0 8px color-mix(in srgb, var(--color-cyan) 80%, transparent));
    }
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    margin: 0 0 0.9rem;
    /* Permitted: large display type. Never on running copy. Blur and
       opacity boosted alongside the Ice-Deep accent swap in tokens.css — see
       the comment on --c-cyan there for why. */
    text-shadow: 0 0 38px color-mix(in srgb, var(--color-cyan) 30%, transparent);
  }

  .headline {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--color-cyan);
    margin: 0 0 1.25rem;
    max-width: 34ch;
  }

  .summary {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 56ch;
    margin: 0 0 2rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ── Sections ─────────────────────────────────────────────────────── */
  .band {
    padding: var(--spacing-section) 0;
  }

  /* ── Capabilities ─────────────────────────────────────────────────── */
  /* The rows own their own borders, so the group needs no rule of its own and
     no spacing; it exists solely to hang `.reveal-stagger` off. */

  /*
    The employment history, compressed to one line.

    This is what is left of the Experience timeline, and the compression is
    deliberate: org, title and dates are what a reader scans for, and they read
    faster in a single mono row than as a rail of dated entries. Anyone who
    wants the entries themselves is one link away.
  */
  .where {
    /* Hangs off the bottom of the capability rows, whose section padding
       supplies the gap below it. Only the space above is this element's to
       set — and the last row no longer draws a closing border, so this strip's
       own top edge is what closes the group. */
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    padding: 0.9rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .where-label {
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .where-role {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .where-org {
    color: var(--color-text);
  }

  .where-title {
    color: var(--color-text-muted);
  }

  .where-period {
    color: var(--color-cyan);
    white-space: nowrap;
  }

  .where-more {
    margin-left: auto;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-state) var(--ease-out);
  }

  .where-more:hover {
    color: var(--color-cyan);
  }

  /* The strip is a row of independent facts on a wide viewport and a stack of
     them on a narrow one; `margin-left: auto` on the link only makes sense
     while there is a row to push it to the end of. */
  @media (max-width: 46rem) {
    .where {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }

    .where-more {
      margin-left: 0;
    }
  }

  /* ── Metrics ──────────────────────────────────────────────────────── */
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 2rem;
  }

  /* ── Projects ─────────────────────────────────────────────────────── */
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 2rem;
  }

  /* ── Education ────────────────────────────────────────────────────── */
  .education {
    display: grid;
    grid-template-columns: minmax(9rem, 1fr) minmax(0, 3fr);
    gap: 2rem;
  }

  .education > * > p,
  .education > p {
    margin: 0;
  }

  .period {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .institution {
    color: var(--color-text);
  }

  .degree {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 46rem) {
    .education {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  /* ── Systems & credentials ────────────────────────────────────────── */
  .systems-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  @media (max-width: 52rem) {
    .systems-grid {
      grid-template-columns: 1fr;
    }
  }

  .head-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-full);
    background: var(--color-cyan);
    box-shadow: var(--glow-cyan);
    flex-shrink: 0;
  }

  .edu p {
    margin: 0;
  }

  .edu-inst {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: 1.4;
  }

  .edu-degree {
    margin-top: 0.35rem !important;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .edu-period {
    margin-top: 0.6rem !important;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-cyan);
  }

  /* A <p> of values joined with ' · ', not a list — so it takes no marker.
     It carried `list-style: none`, `padding: 0` and a `li::before` rule until
     this pass, all of it left over from when it was a <ul>; the ::before could
     never match. Inline separators are a different device from list markers
     and stay as they are. */
  .edu-highlights {
    margin: 0.8rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* ── Education ────────────────────────────────────────────────────── */
  .head-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-full);
    background: var(--color-cyan);
    box-shadow: var(--glow-cyan);
    flex-shrink: 0;
  }

  .edu-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .edu-top p {
    margin: 0;
  }

  .edu-degree {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--color-text);
  }

  .edu-highlights {
    margin-top: 0.4rem !important;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .edu-period {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-cyan);
    white-space: nowrap;
  }

  /* Right-hand column of the module head: the readout, then the dates under
     it. Right-aligned so the GPA's digits sit on the module's edge and read
     as an instrument value rather than as a stray word in a sentence. */
  .edu-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
  }

  .edu-gpa {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 !important;
  }

  /* Not `.gpa-value`: build-output.test.ts asserts that a `value` readout
     only ever appears inside a capability row, and matches on the class name
     with a \b word boundary — so `gpa-value` trips a guard it does not
     actually violate. */
  .gpa-figure {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--color-cyan);
    /* Permitted: display-size readout, not running copy — same exception the
       capability metrics take. */
    text-shadow: 0 0 28px color-mix(in srgb, var(--color-cyan) 38%, transparent);
  }

  .gpa-unit {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  /* Stacked, the readout leads and the dates follow it, both left-aligned
     with everything else rather than stranded against the right edge. */
  @media (max-width: 46rem) {
    .edu-side {
      align-items: flex-start;
    }
  }

  .coursework {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .coursework-label {
    margin: 0 0 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .coursework ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Marker comes from `.marker-list` in global.css. */
  .coursework li {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* ── Contact ──────────────────────────────────────────────────────── */
  .contact {
    display: grid;
    /* Both columns sized to their content and packed to the start, rather than
       a 1fr copy column that stretched to the container and shoved the dish
       against the right edge. The copy is capped at 44ch either way, so the
       old 1fr was pure empty space between the two things that belong
       together. */

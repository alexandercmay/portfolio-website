---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Button from '@/components/Button.astro'
import Rule from '@/components/Rule.astro'
import SectionHeader from '@/components/SectionHeader.astro'
import Label from '@/components/Label.astro'
import ExperienceEntry from '@/components/ExperienceEntry.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import SkillGalaxy from '@/components/SkillGalaxy.astro'
import { getFeaturedProjects, formatPeriod } from '@/lib/content'
import { resume } from '../../content/resume'

const { basics, work, education, skills } = resume

const featuredRoles = work
  .filter((r) => r.featured)
  .sort((a, b) => (b.weight ?? 0) - (a.weight ?? 0))

const featuredProjects = await getFeaturedProjects(3)
---

<BaseLayout
  title={`${basics.name} — ${basics.headline}`}
  description={basics.summary}
  wide
>
  {
    /*
    HERO — the scan test.
    Name, headline, and a contact affordance must be visible at 375px without
    scrolling, at full opacity on first paint. No animation, no reveal class,
    nothing that delays it. Everything below this may be as expressive as it
    likes; this may not.
  */
  }
  <section class="hero" aria-label="Introduction">
    <div class="ambient" aria-hidden="true"></div>
    <div class="wrap">
      <Label class="status">
        <span class="live" aria-hidden="true"></span>
        Open to full-stack &amp; AI engineering roles
      </Label>
      <h1>{basics.name}</h1>
      <p class="headline">{basics.headline}</p>
      <p class="summary">{basics.summary}</p>
      <div class="actions">
        <Button href={`mailto:${basics.email}`}>Get in touch</Button>
        <Button href="/alexander-may-resume.pdf" variant="secondary" download>
          Download resume
        </Button>
      </div>
    </div>
  </section>

  <div class="wrap">
    <Rule />

    {/* SELECTED EXPERIENCE — the heart of the page. */}
    <section class="band" aria-labelledby="experience">
      <SectionHeader index="01" id="experience" title="Experience" />
      <div class="timeline reveal-stagger">
        {featuredRoles.map((role) => <ExperienceEntry role={role} />)}
      </div>

      <a class="timeline-more" href="/resume">
        <span class="tm-icon" aria-hidden="true"></span>
        View the full detailed timeline
      </a>
    </section>

    {
      /* METRICS — renders nothing at all when there are no real numbers.
        Three invented-sounding figures do more damage than none. */
    }
    <Rule />

    <section class="band reveal" aria-labelledby="work">
      <SectionHeader
        index="02"
        id="work"
        title="Projects"
        href="/projects"
        linkLabel="All projects"
      />
      <div class="projects reveal-stagger">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <Rule />

    <section class="band" aria-labelledby="skills">
      <SectionHeader index="03" id="skills" title="Skills" />
      <div class="reveal-stagger">
        <SkillGalaxy groups={skills} />
      </div>
    </section>

    <Rule />

    <section class="band" aria-labelledby="education">
      <SectionHeader index="04" id="education" title="Education" />

      {
        education.map((e) => (
          <div class="module marks edu-module reveal">
            <div class="module-head">
              <span class="head-dot" aria-hidden="true" />
              {e.institution}
            </div>

            <div class="module-body">
              <div class="edu-top">
                <div>
                  <p class="edu-degree">
                    {e.degree} {e.field}
                  </p>
                  {e.highlights.length > 0 && (
                    <p class="edu-highlights">{e.highlights.join(' · ')}</p>
                  )}
                </div>
                <p class="edu-period">{formatPeriod(e.start, e.end)}</p>
              </div>

              {e.coursework && e.coursework.length > 0 && (
                <div class="coursework">
                  <p class="coursework-label">Relevant coursework</p>
                  <ul>
                    {e.coursework.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        ))
      }
    </section>

    <Rule />

    <section class="band" aria-labelledby="contact">
      <SectionHeader index="05" id="contact" title="Get in touch" />

      <div class="module marks reveal">
        <div class="module-head">
          <span class="head-dot" aria-hidden="true"></span>
          Contact
        </div>
        <div class="module-body contact-panel">
          <p class="lead">
            I'm looking for full-stack and AI engineering roles. The fastest way to reach
            me is email.
          </p>
          <div class="actions">
            <Button href={`mailto:${basics.email}`}>{basics.email}</Button>
            {
              basics.profiles.map((profile) => (
                <Button href={profile.url} variant="secondary">
                  {profile.network}
                </Button>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--container-content);
    margin: 0 auto;
    padding-inline: 1.5rem;
  }

  .education,
  .contact .lead,
  .summary {
    /* Prose sits on the page ground rather than over the grid. */
    position: relative;
  }

  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    isolation: isolate;
    padding: clamp(2.5rem, 8vw, 5rem) 0 clamp(2.5rem, 6vw, 4rem);
  }

  /* No reveal class anywhere in the hero. Name, headline, and contact render
     at full opacity on first paint — the scan test depends on it. */
  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    color: var(--color-lime);
  }

  .live {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: var(--radius-full);
    background: var(--color-lime);
    box-shadow:
      var(--glow-lime),
      0 0 0 2px color-mix(in srgb, var(--color-lime) 22%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .live {
      animation: pulse-live 2.4s var(--ease-out) infinite;
    }
  }

  @keyframes pulse-live {
    0%,
    100% {
      box-shadow:
        var(--glow-lime),
        0 0 0 2px color-mix(in srgb, var(--color-lime) 22%, transparent);
    }
    50% {
      box-shadow:
        0 0 16px color-mix(in srgb, var(--color-lime) 70%, transparent),
        0 0 0 5px color-mix(in srgb, var(--color-lime) 8%, transparent);
    }
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    margin: 0 0 0.9rem;
    /* Permitted: large display type. Never on running copy. */
    text-shadow: 0 0 32px color-mix(in srgb, var(--color-cyan) 22%, transparent);
  }

  .headline {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--color-cyan);
    margin: 0 0 1.25rem;
    max-width: 34ch;
  }

  .summary {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 56ch;
    margin: 0 0 2rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ── Sections ─────────────────────────────────────────────────────── */
  .band {
    padding: var(--spacing-section) 0;
  }

  /*
    Scroll-linked progress rule down the experience section.

    Base state is a fully drawn rule, so browsers without animation-timeline
    and readers with reduced motion get a correct static line rather than a
    missing one. The animation only ever *removes* ink that is already there.
  */
  .timeline {
    position: relative;
    padding-left: 1.75rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    border-radius: var(--radius-full);
    background: var(--color-border);
  }

  .timeline::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    border-radius: var(--radius-full);
    background: linear-gradient(var(--color-cyan), var(--color-violet));
    box-shadow: var(--glow-cyan);
    transform-origin: top;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .timeline::after {
        animation: draw linear both;
        animation-timeline: view();
        animation-range: entry 90% exit 10%;
      }
    }
  }

  @keyframes draw {
    from {
      scale: 1 0;
    }
    to {
      scale: 1 1;
    }
  }

  @media (max-width: 46rem) {
    .timeline {
      padding-left: 1rem;
    }
  }

  /* ── Metrics ──────────────────────────────────────────────────────── */
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 2rem;
  }

  /* ── Projects ─────────────────────────────────────────────────────── */
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 2rem;
  }

  /* ── Education ────────────────────────────────────────────────────── */
  .education {
    display: grid;
    grid-template-columns: minmax(9rem, 1fr) minmax(0, 3fr);
    gap: 2rem;
  }

  .education > * > p,
  .education > p {
    margin: 0;
  }

  .period {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .institution {
    color: var(--color-text);
  }

  .degree {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 46rem) {
    .education {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  /* ── Systems & credentials ────────────────────────────────────────── */
  .systems-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  @media (max-width: 52rem) {
    .systems-grid {
      grid-template-columns: 1fr;
    }
  }

  .head-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-full);
    background: var(--color-cyan);
    box-shadow: var(--glow-cyan);
    flex-shrink: 0;
  }

  .edu p {
    margin: 0;
  }

  .edu-inst {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: 1.4;
  }

  .edu-degree {
    margin-top: 0.35rem !important;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .edu-period {
    margin-top: 0.6rem !important;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-cyan);
  }

  .edu-highlights {
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .edu-highlights li::before {
    content: '· ';
    color: var(--color-cyan);
  }

  /* ── Full timeline link ───────────────────────────────────────────── */
  .timeline-more {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: 1.75rem;
    padding: 0.65em 1.1em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      color var(--duration-state) var(--ease-out),
      border-color var(--duration-state) var(--ease-out),
      box-shadow var(--duration-state) var(--ease-out);
  }

  .timeline-more:hover {
    color: var(--color-cyan);
    border-color: var(--color-cyan);
    box-shadow: var(--glow-cyan);
  }

  .tm-icon {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-full);
    background: var(--color-cyan);
    box-shadow: var(--glow-cyan);
  }

  @media (max-width: 46rem) {
    .timeline-more {
      margin-left: 1rem;
    }
  }

  /* ── Education ────────────────────────────────────────────────────── */
  .head-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-full);
    background: var(--color-cyan);
    box-shadow: var(--glow-cyan);
    flex-shrink: 0;
  }

  .edu-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .edu-top p {
    margin: 0;
  }

  .edu-degree {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--color-text);
  }

  .edu-highlights {
    margin-top: 0.4rem !important;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .edu-period {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-cyan);
    white-space: nowrap;
  }

  .coursework {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .coursework-label {
    margin: 0 0 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .coursework ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .coursework li {
    position: relative;
    padding-left: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .coursework li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 1px;
    background: var(--color-cyan);
    opacity: 0.8;
  }

  /* ── Contact ──────────────────────────────────────────────────────── */
  .contact-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .contact-panel .lead {
    max-width: 40ch;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>

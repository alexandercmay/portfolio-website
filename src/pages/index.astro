---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Button from '@/components/Button.astro'
import Rule from '@/components/Rule.astro'
import SectionHeader from '@/components/SectionHeader.astro'
import Label from '@/components/Label.astro'
import CapabilityRow from '@/components/CapabilityRow.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import SkillGalaxy from '@/components/SkillGalaxy.astro'
import { getFeaturedProjects, formatPeriod } from '@/lib/content'
import { resume } from '../../content/resume'

const { basics, work, capabilities, education, skills } = resume

/**
 * The `Where` strip under the capabilities: every role, newest first.
 *
 * Deliberately ALL of them and not the `featured` subset. The strip exists so
 * a reader looking for an employer and a date finds one without leaving the
 * page, and a filtered employment history does that job badly.
 */
const roles = [...work].sort((a, b) => b.start.getTime() - a.start.getTime())

const featuredProjects = await getFeaturedProjects(3)
---

<BaseLayout
  title={`${basics.name} — ${basics.headline}`}
  description={basics.summary}
  wide
>
  {
    /*
    HERO — the scan test.
    Name, headline, and a contact affordance must be visible at 375px without
    scrolling, at full opacity on first paint. No animation, no reveal class,
    nothing that delays it. Everything below this may be as expressive as it
    likes; this may not.
  */
  }
  <section class="hero" aria-label="Introduction">
    <div class="ambient" aria-hidden="true"></div>
    <div class="wrap">
      <Label class="status">
        <span class="live" aria-hidden="true"></span>
        Open to full-stack &amp; AI engineering roles
      </Label>
      <h1>{basics.name}</h1>
      <p class="headline">{basics.headline}</p>
      <p class="summary">{basics.summary}</p>
      <div class="actions">
        <Button href={`mailto:${basics.email}`} transmit>Get in touch</Button>
        <Button href="/alexander-may-resume.pdf" variant="secondary" download>
          Download resume
        </Button>
      </div>
    </div>
  </section>

  <div class="wrap">
    <Rule />

    {
      /* WHAT I BUILD — the heart of the page.
         Capabilities, not a timeline: the reader arrives asking what he can
         do, and the employment history they might also want is one line down
         in the `Where` strip. See the note on `Capability` in resume.ts. */
    }
    <section class="band" aria-labelledby="capabilities">
      <SectionHeader index="01" id="capabilities" title="What I build" />
      <div class="capabilities reveal-stagger">
        {capabilities.map((capability) => <CapabilityRow capability={capability} />)}
      </div>

      <div class="where reveal">
        <span class="where-label">Where</span>
        {
          roles.map((role) => (
            <span class="where-role">
              <span class="where-org">{role.org}</span>
              <span class="where-title">{role.shortTitle ?? role.title}</span>
              <span class="where-period">{formatPeriod(role.start, role.end)}</span>
            </span>
          ))
        }
        <a class="where-more" href="/resume">Full resume &rarr;</a>
      </div>
    </section>

    {
      /* METRICS — renders nothing at all when there are no real numbers.
        Three invented-sounding figures do more damage than none. */
    }
    <Rule />

    <section class="band reveal" aria-labelledby="work">
      <SectionHeader
        index="02"
        id="work"
        title="Projects"
        href="/projects"
        linkLabel="All projects"
      />
      <div class="projects reveal-stagger">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <Rule />

    <section class="band" aria-labelledby="skills">
      <SectionHeader index="03" id="skills" title="Skills" />
      <div class="reveal-stagger">
        <SkillGalaxy groups={skills} />
      </div>
    </section>

    <Rule />

    <section class="band" aria-labelledby="education">
      <SectionHeader index="04" id="education" title="Education" />

      {
        education.map((e) => (
          <div class="module marks edu-module reveal">
            <div class="module-head">
              <span class="head-dot" aria-hidden="true" />
              {e.institution}
            </div>

            <div class="module-body">
              <div class="edu-top">
                <div>
                  <p class="edu-degree">
                    {e.degree} {e.field}
                  </p>
                  {e.highlights.length > 0 && (
                    <p class="edu-highlights">{e.highlights.join(' · ')}</p>
                  )}
                </div>
                <p class="edu-period">{formatPeriod(e.start, e.end)}</p>
              </div>

              {e.coursework && e.coursework.length > 0 && (
                <div class="coursework">
                  <p class="coursework-label">Relevant coursework</p>
                  <ul class="marker-list" role="list">
                    {e.coursework.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        ))
      }
    </section>

    <Rule />

    <section class="band" aria-labelledby="contact">
      <SectionHeader index="05" id="contact" title="Get in touch" />

      <div class="module marks reveal">
        <div class="module-head">
          <span class="head-dot" aria-hidden="true"></span>
          Contact
        </div>
        <div class="module-body contact-panel">
          <p class="lead">
            I'm looking for full-stack and AI engineering roles. The fastest way to reach
            me is email.
          </p>
          <div class="actions">
            <Button href={`mailto:${basics.email}`} transmit>
              {basics.email}
            </Button>
            {
              basics.profiles.map((profile) => (
                <Button href={profile.url} variant="secondary">
                  {profile.network}
                </Button>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--container-content);
    margin: 0 auto;
    padding-inline: 1.5rem;
  }

  .education,
  .contact .lead,
  .summary {
    /* Prose sits on the page ground rather than over the grid. */
    position: relative;
  }

  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    isolation: isolate;
    /* The ambient wash bleeds 10% past both sides so its soft edge is never
       visible. Without this it also bleeds past the VIEWPORT: on a 390px
       phone that is 39px of extra document width, which makes the page
       horizontally scrollable and leaves the centred content sitting against
       the left edge with a gap on the right. Reported on iOS Safari; it was
       there in every browser, just less obvious with a visible scrollbar.

       `clip` and not `hidden`: it does the same job without making the hero a
       scroll container. */
    overflow: clip;
    padding: clamp(2.5rem, 8vw, 5rem) 0 clamp(2.5rem, 6vw, 4rem);
  }

  /* No reveal class anywhere in the hero. Name, headline, and contact render
     at full opacity on first paint — the scan test depends on it. */
  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    color: var(--color-lime);
  }

  .live {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: var(--radius-full);
    background: var(--color-lime);
    box-shadow:
      var(--glow-lime),
      0 0 0 2px color-mix(in srgb, var(--color-lime) 22%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .live {
      animation: pulse-live 2.4s var(--ease-out) infinite;
    }
  }

  @keyframes pulse-live {
    0%,
    100% {
      box-shadow:
        var(--glow-lime),
        0 0 0 2px color-mix(in srgb, var(--color-lime) 22%, transparent);
    }
    50% {
      box-shadow:
        0 0 16px color-mix(in srgb, var(--color-lime) 70%, transparent),
        0 0 0 5px color-mix(in srgb, var(--color-lime) 8%, transparent);
    }
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    margin: 0 0 0.9rem;
    /* Permitted: large display type. Never on running copy. */
    text-shadow: 0 0 32px color-mix(in srgb, var(--color-cyan) 22%, transparent);
  }

  .headline {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--color-cyan);
    margin: 0 0 1.25rem;
    max-width: 34ch;
  }

  .summary {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 56ch;
    margin: 0 0 2rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ── Sections ─────────────────────────────────────────────────────── */
  .band {
    padding: var(--spacing-section) 0;
  }

  /* ── Capabilities ─────────────────────────────────────────────────── */
  /*
    The rows own their own borders, so the group needs no rule of its own; it
    exists to hang `.reveal-stagger` off and to keep the `Where` strip attached
    to the section rather than floating between it and the next.
  */
  .capabilities {
    margin-bottom: 1.75rem;
  }

  /*
    The employment history, compressed to one line.

    This is what is left of the Experience timeline, and the compression is
    deliberate: org, title and dates are what a reader scans for, and they read
    faster in a single mono row than as a rail of dated entries. Anyone who
    wants the entries themselves is one link away.
  */
  .where {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    padding: 0.9rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .where-label {
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .where-role {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .where-org {
    color: var(--color-text);
  }

  .where-title {
    color: var(--color-text-muted);
  }

  .where-period {
    color: var(--color-cyan);
    white-space: nowrap;
  }

  .where-more {
    margin-left: auto;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-state) var(--ease-out);
  }

  .where-more:hover {
    color: var(--color-cyan);
  }

  /* The strip is a row of independent facts on a wide viewport and a stack of
     them on a narrow one; `margin-left: auto` on the link only makes sense
     while there is a row to push it to the end of. */
  @media (max-width: 46rem) {
    .where {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }

    .where-more {
      margin-left: 0;
    }
  }

  /* ── Metrics ──────────────────────────────────────────────────────── */
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 2rem;
  }

  /* ── Projects ─────────────────────────────────────────────────────── */
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 2rem;
  }

  /* ── Education ────────────────────────────────────────────────────── */
  .education {
    display: grid;
    grid-template-columns: minmax(9rem, 1fr) minmax(0, 3fr);
    gap: 2rem;
  }

  .education > * > p,
  .education > p {
    margin: 0;
  }

  .period {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .institution {
    color: var(--color-text);
  }

  .degree {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 46rem) {
    .education {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  /* ── Systems & credentials ────────────────────────────────────────── */
  .systems-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  @media (max-width: 52rem) {
    .systems-grid {
      grid-template-columns: 1fr;
    }
  }

  .head-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-full);
    background: var(--color-cyan);
    box-shadow: var(--glow-cyan);
    flex-shrink: 0;
  }

  .edu p {
    margin: 0;
  }

  .edu-inst {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: 1.4;
  }

  .edu-degree {
    margin-top: 0.35rem !important;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .edu-period {
    margin-top: 0.6rem !important;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-cyan);
  }

  /* A <p> of values joined with ' · ', not a list — so it takes no marker.
     It carried `list-style: none`, `padding: 0` and a `li::before` rule until
     this pass, all of it left over from when it was a <ul>; the ::before could
     never match. Inline separators are a different device from list markers
     and stay as they are. */
  .edu-highlights {
    margin: 0.8rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* ── Education ────────────────────────────────────────────────────── */
  .head-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-full);
    background: var(--color-cyan);
    box-shadow: var(--glow-cyan);
    flex-shrink: 0;
  }

  .edu-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .edu-top p {
    margin: 0;
  }

  .edu-degree {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--color-text);
  }

  .edu-highlights {
    margin-top: 0.4rem !important;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .edu-period {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-cyan);
    white-space: nowrap;
  }

  .coursework {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .coursework-label {
    margin: 0 0 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .coursework ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Marker comes from `.marker-list` in global.css. */
  .coursework li {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* ── Contact ──────────────────────────────────────────────────────── */
  .contact-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .contact-panel .lead {
    max-width: 40ch;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>

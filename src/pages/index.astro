---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Button from '@/components/Button.astro'
import Rule from '@/components/Rule.astro'
import SectionHeader from '@/components/SectionHeader.astro'
import ExperienceEntry from '@/components/ExperienceEntry.astro'
import MetricFigure from '@/components/MetricFigure.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import SkillsComposition from '@/components/SkillsComposition.astro'
import { getFeaturedProjects, formatPeriod } from '@/lib/content'
import { resume } from '../../content/resume'

const { basics, work, education, skills, metrics } = resume

const featuredRoles = work
  .filter((r) => r.featured)
  .sort((a, b) => (b.weight ?? 0) - (a.weight ?? 0))

const featuredProjects = await getFeaturedProjects(3)
---

<BaseLayout
  title={`${basics.name} — ${basics.headline}`}
  description={basics.summary}
  wide
>
  {
    /*
    HERO — the scan test.
    Name, headline, and a contact affordance must be visible at 375px without
    scrolling, at full opacity on first paint. No animation, no reveal class,
    nothing that delays it. Everything below this may be as expressive as it
    likes; this may not.
  */
  }
  <section class="hero" aria-label="Introduction">
    <div class="wrap">
      <h1>{basics.name}</h1>
      <p class="headline">{basics.headline}</p>
      <p class="summary">{basics.summary}</p>
      <div class="actions">
        <Button href={`mailto:${basics.email}`}>Get in touch</Button>
        <Button href="/alexander-may-resume.pdf" variant="secondary" download>
          Download resume
        </Button>
      </div>
    </div>
  </section>

  <div class="wrap">
    <Rule />

    {/* SELECTED EXPERIENCE — the heart of the page. */}
    <section class="band" aria-labelledby="experience">
      <SectionHeader
        id="experience"
        title="Selected experience"
        href="/resume"
        linkLabel="Full work history"
      />
      <div class="timeline">
        {featuredRoles.map((role) => <ExperienceEntry role={role} />)}
      </div>
    </section>

    {
      /* METRICS — renders nothing at all when there are no real numbers.
        Three invented-sounding figures do more damage than none. */
    }
    {
      metrics && metrics.length > 0 && (
        <>
          <Rule />
          <section class="band metrics reveal" aria-label="Key numbers">
            {metrics.map((m) => (
              <MetricFigure value={m.value} label={m.label} />
            ))}
          </section>
        </>
      )
    }

    <Rule />

    <section class="band reveal" aria-labelledby="work">
      <SectionHeader
        id="work"
        title="Selected work"
        href="/projects"
        linkLabel="All projects"
      />
      <div class="projects">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <Rule />

    <section class="band reveal" aria-labelledby="skills">
      <SectionHeader id="skills" title="Skills" />
      <SkillsComposition groups={skills} />
    </section>

    <Rule />

    <section class="band reveal" aria-labelledby="education">
      <SectionHeader id="education" title="Education" />
      {
        education.map((e) => (
          <div class="education">
            <p class="period">{formatPeriod(e.start, e.end)}</p>
            <div>
              <p class="institution">{e.institution}</p>
              <p class="degree">
                {e.degree} {e.field}
              </p>
            </div>
          </div>
        ))
      }
    </section>

    <Rule />

    <section class="band reveal contact" aria-labelledby="contact">
      <SectionHeader id="contact" title="Get in touch" />
      <p class="lead">
        I'm looking for full-stack and AI engineering roles. The fastest way to reach me
        is email.
      </p>
      <div class="actions">
        <Button href={`mailto:${basics.email}`}>{basics.email}</Button>
        {
          basics.profiles.map((p) => (
            <Button href={p.url} variant="secondary">
              {p.network}
            </Button>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--container-content);
    margin: 0 auto;
    padding-inline: 1.5rem;
  }

  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero {
    padding: clamp(2.5rem, 8vw, 5rem) 0 clamp(2.5rem, 6vw, 4rem);
  }

  h1 {
    font-size: var(--text-display);
    letter-spacing: var(--tracking-display);
    margin: 0 0 0.75rem;
  }

  .headline {
    font-size: var(--text-lg);
    color: var(--color-text);
    margin: 0 0 1.25rem;
    max-width: 30ch;
  }

  .summary {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 56ch;
    margin: 0 0 2rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ── Sections ─────────────────────────────────────────────────────── */
  .band {
    padding: var(--spacing-section) 0;
  }

  /*
    Scroll-linked progress rule down the experience section.

    Base state is a fully drawn rule, so browsers without animation-timeline
    and readers with reduced motion get a correct static line rather than a
    missing one. The animation only ever *removes* ink that is already there.
  */
  .timeline {
    position: relative;
    padding-left: 1.5rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-rule);
    opacity: 0.15;
  }

  .timeline::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-accent);
    transform-origin: top;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .timeline::after {
        animation: draw linear both;
        animation-timeline: view();
        animation-range: entry 90% exit 10%;
      }
    }
  }

  @keyframes draw {
    from {
      scale: 1 0;
    }
    to {
      scale: 1 1;
    }
  }

  @media (max-width: 46rem) {
    .timeline {
      padding-left: 1rem;
    }
  }

  /* ── Metrics ──────────────────────────────────────────────────────── */
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 2rem;
  }

  /* ── Projects ─────────────────────────────────────────────────────── */
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 2rem;
  }

  /* ── Education ────────────────────────────────────────────────────── */
  .education {
    display: grid;
    grid-template-columns: minmax(9rem, 1fr) minmax(0, 3fr);
    gap: 2rem;
  }

  .education > * > p,
  .education > p {
    margin: 0;
  }

  .period {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .institution {
    color: var(--color-text);
  }

  .degree {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 46rem) {
    .education {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  /* ── Contact ──────────────────────────────────────────────────────── */
  .contact .lead {
    max-width: 52ch;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
  }
</style>

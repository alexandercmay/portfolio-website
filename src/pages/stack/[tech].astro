---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import ExperienceEntry from '@/components/ExperienceEntry.astro'
import EmptyState from '@/components/EmptyState.astro'
import { getStackUsage } from '@/lib/content'

/**
 * A prerendered page per technology — not a client-side filter.
 *
 * Answers the exact question a hiring manager has: has this person actually
 * used the thing in my job description. Loads instantly, works without JS, is
 * linkable, and gives a real page for "Alexander May PyTorch" in search
 * results.
 *
 * getStackUsage() only returns technologies with at least one use, so no
 * empty pages are generated — a stack page listing nothing is worse than no
 * stack page at all.
 */
export async function getStaticPaths() {
  const usage = await getStackUsage()
  return usage.map((u) => ({ params: { tech: u.key }, props: { usage: u } }))
}

const { usage } = Astro.props
const total = usage.projects.length + usage.roles.length
---

<BaseLayout
  title={`${usage.label} — Alexander May`}
  description={`Projects and roles where I used ${usage.label}.`}
>
  <div class="head">
    <p class="eyebrow">{usage.category}</p>
    <h1>{usage.label}</h1>
    <p class="lead">
      {total === 1 ? '1 place' : `${total} places`} I have used {usage.label}.
    </p>
  </div>

  {
    usage.roles.length > 0 && (
      <section class="band" aria-labelledby="experience">
        <h2 id="experience">Experience</h2>
        {usage.roles.map((role) => (
          <ExperienceEntry role={role} variant="full" />
        ))}
      </section>
    )
  }

  {
    usage.projects.length > 0 && (
      <section class="band" aria-labelledby="projects">
        <h2 id="projects">Projects</h2>
        <div class="grid">
          {usage.projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    )
  }

  {
    total === 0 && (
      <EmptyState
        message="Nothing here yet."
        actionHref="/projects"
        actionLabel="See all projects"
      />
    )
  }

  <p class="back"><a href="/projects">&larr; All projects</a></p>
</BaseLayout>

<style>
  .head {
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin: 0 0 0.5rem;
  }

  h1 {
    font-size: var(--text-3xl);
    margin: 0 0 0.5rem;
  }

  .lead {
    margin: 0;
    color: var(--color-text-muted);
  }

  .band {
    padding: 2.5rem 0;
    border-top: 1px solid var(--color-border);
  }

  h2 {
    font-size: var(--text-xl);
    margin: 0 0 0.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 2.5rem;
    margin-top: 1.5rem;
  }

  .back {
    padding: 2rem 0 var(--spacing-section);
    font-size: var(--text-sm);
  }

  .back a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--color-accent);
  }
</style>

---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Button from '@/components/Button.astro'
import { resume } from '../../content/resume'

/**
 * The classical view: the resume as a document, embedded.
 *
 * The homepage is the "resume told well" — this page is for the reader who
 * expects the paper artifact and wants to read or save exactly that. It embeds
 * the PDF full-bleed with a hard download link as the fallback for viewers
 * (mobile Safari, in particular) that won't render a PDF inline.
 *
 * The PDF is the file at public/alexander-may-resume.pdf. It is currently
 * hand-maintained (exported from the LaTeX source in the Job Hunt repo), so it
 * can drift from content/resume.ts — see docs/06-decisions.md D-005. Regenerate
 * it there when the structured resume changes.
 */
const { basics, work, education } = resume
const PDF = '/alexander-may-resume.pdf'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: basics.name,
  jobTitle: basics.headline,
  email: `mailto:${basics.email}`,
  address: { '@type': 'PostalAddress', addressLocality: basics.location },
  url: Astro.site?.href,
  sameAs: basics.profiles.map((p) => p.url),
  alumniOf: education.map((e) => ({
    '@type': 'CollegeOrUniversity',
    name: e.institution,
  })),
  worksFor: work
    .filter((w) => !w.end)
    .map((w) => ({ '@type': 'Organization', name: w.org })),
}
---

<BaseLayout
  title="Resume — Alexander May"
  description={`Downloadable resume (PDF) for ${basics.name} — ${basics.headline}.`}
  jsonLd={jsonLd}
  wide
>
  <section class="viewer" aria-label="Resume document">
    <div class="bar">
      <h1>Resume</h1>
      <div class="actions">
        <Button href={PDF} variant="secondary" download>Download PDF</Button>
        <Button href={PDF} variant="secondary" target="_blank" rel="noopener"
          >Open in new tab</Button
        >
      </div>
    </div>

    <object class="doc" data={`${PDF}#view=FitH`} type="application/pdf">
      <div class="fallback">
        <p>Your browser can't display the embedded PDF. Open it directly instead:</p>
        <Button href={PDF} download>Download the resume (PDF)</Button>
      </div>
    </object>

    <p class="hint">
      Not rendering? Many phones won't preview a PDF inline &mdash;
      <a href={PDF} target="_blank" rel="noopener">open it in a new tab</a> or
      <a href={PDF} download>download it</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .viewer {
    max-width: var(--container-content);
    margin: 0 auto;
    padding: 2rem 1.5rem var(--spacing-section);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.25rem;
  }

  h1 {
    font-size: var(--text-2xl);
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .doc {
    display: block;
    width: 100%;
    /* Tall enough to read a page without the outer scrollbar fighting the
       PDF's own. Falls back to the flow box when the <object> can't render. */
    height: min(85vh, 1100px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .fallback {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: 2rem;
  }

  .fallback p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .hint {
    margin: 0.9rem 0 0;
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .hint a {
    color: var(--color-text-muted);
  }

  .hint a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 46rem) {
    .doc {
      height: 60vh;
    }
  }
</style>

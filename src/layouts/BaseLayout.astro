---
import '@/styles/global.css'
import SEO from '@/components/SEO.astro'
import ThemeScript from '@/components/ThemeScript.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'

interface Props {
  title: string
  description?: string
  image?: string
  noindex?: boolean
  /** Full-bleed pages opt out of the default content container. */
  wide?: boolean
  /**
   * schema.org structured data. Emitted as application/ld+json, which is a
   * <script> tag but carries no executable code — the zero-JS tests exclude
   * it by type for exactly that reason.
   */
  jsonLd?: Record<string, unknown>
}

const { title, description, image, noindex, wide, jsonLd } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <SEO title={title} description={description} image={image} noindex={noindex} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Display face is above the fold in the hero, so it is preloaded.
         Metric-matched fallback in fonts.css keeps the swap from shifting. -->
    <link
      rel="preload"
      href="/fonts/fraunces-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class:list={[!wide && 'container']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .container {
    max-width: var(--container-content);
    margin: 0 auto;
    padding: 3rem 1.5rem 0;
  }
</style>
